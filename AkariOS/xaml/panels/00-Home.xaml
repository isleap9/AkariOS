<!--
  ==========================================================================
  00-Home  -  welcome screen, "Install AkariOS" CTA, and the per-stage
  explanation cards (SAFE-03: what each stage does, what it costs).

  Buttons auto-wire by Name: a Button named Btn&lt;Something&gt; is handled by the
  function Invoke-Btn&lt;Something&gt; in functions/public/*.ps1, matched at startup
  by scripts/main.ps1. (So keep button Name and function name in sync.)

  This file is a FRAGMENT injected into xaml/MainWindow.xaml at the @PANELS@ marker.
  Page order = the NN- number in this file name. The matching sidebar item (NavHome)
  and the Nav -> Panel map live in MainWindow.xaml and scripts/main.ps1.

  Symbols must be XML entities, never pasted raw (raw bytes corrupt on compile):
  &#183; = middle dot,  &#9888; = warning sign.
  ==========================================================================
-->
<ScrollViewer Name="PanelHome" Padding="24,20,24,16">
    <StackPanel>
        <TextBlock Text="Home" Style="{StaticResource H1}"/>

        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="White"
                           FontFamily="Segoe UI Variable Display, Segoe UI">
                    <Run Text="Welcome to Akari"/><Run Text="OS" Foreground="#E03535"/>
                </TextBlock>
                <TextBlock Style="{StaticResource CardDesc}" Margin="0,6,0,0"
                           Text="This tool will transform your Windows installation into AkariOS &#8212; a clean, debloated, performance-tuned system. The process runs across three stages and two reboots. Click 'Install AkariOS' when you're ready to begin."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardDanger}">
            <StackPanel>
                <TextBlock Text="&#9888;  THIS WILL CHANGE YOUR SYSTEM" Style="{StaticResource CardGroupHeader}" Foreground="#FF6B6B"/>
                <TextBlock Style="{StaticResource CardDesc}" Margin="0"
                           Text="Windows Defender, UAC, memory integrity, VBS and the vulnerable-driver blocklist are disabled. Edge, UWP apps and GPU/audio drivers are removed. A system restore point is strongly recommended before you start."/>
            </StackPanel>
        </Border>

        <!-- Per-stage explanation (SAFE-03) -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="WHAT THE INSTALL DOES" Style="{StaticResource CardGroupHeader}"/>

                <!-- Stage 1 -->
                <Border Style="{StaticResource ChecklistItem}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Stage 1 "/><Run Text="&#183; Prepare and reboot" Foreground="#E03535"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardDesc}"
                                   Text="Stage 1: Downloads required payloads, configures boot settings, and reboots into Safe Mode."/>
                        <TextBlock Style="{StaticResource CardDesc}" Foreground="#FFA726"
                                   Text="Cost: downloads several hundred MB and reboots the machine. You can cancel right up to the reboot."/>
                    </StackPanel>
                </Border>

                <!-- Stage 2 -->
                <Border Style="{StaticResource ChecklistItem}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Stage 2 "/><Run Text="&#183; Safe Mode (console only)" Foreground="#E03535"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardDesc}"
                                   Text="Stage 2: Runs in Safe Mode as TrustedInstaller. Disables Defender, modifies system protections, and reboots."/>
                        <TextBlock Style="{StaticResource CardDesc}" Foreground="#FFA726"
                                   Text="Cost: permanently reduces your security posture. Run from a console window because the GUI does not render in Safe Mode. Cancel is no longer available."/>
                    </StackPanel>
                </Border>

                <!-- Stage 3 -->
                <Border Style="{StaticResource ChecklistItem}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}">
                            <Run Text="Stage 3 "/><Run Text="&#183; Tweaks and branding" Foreground="#E03535"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource CardDesc}"
                                   Text="Stage 3: Removes bloatware, applies performance tweaks, sets AkariOS branding, and reboots to complete."/>
                        <TextBlock Style="{StaticResource CardDesc}" Foreground="#FFA726"
                                   Text="Cost: removes applications and drivers that are not trivially reinstalled. A system restore point is the only reliable way back."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <Button Name="BtnInstall" Content="Install AkariOS" Style="{StaticResource BtnAccent}"
                        HorizontalAlignment="Left" IsEnabled="False"/>
                <TextBlock Name="HomeHint" Style="{StaticResource CardDesc}" Margin="0,10,0,0"
                           Text="Run the pre-flight checks first to enable this button."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="LOG" Style="{StaticResource CardGroupHeader}"/>
                <TextBlock Style="{StaticResource CardDesc}" Margin="0"
                           Text="Every action and error is written to %ProgramData%\AkariOS\install.log"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>