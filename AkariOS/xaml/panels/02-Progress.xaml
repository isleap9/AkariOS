<!--
  ==========================================================================
  02-Progress  -  install progress display (PROG-01).

  Shows "Step {N} of 3" at all times, the per-stage progress bar, the current
  action text, and the cancel button whose enabled state is driven by
  Get-CanCancel (SAFE-04).

  This file is a FRAGMENT injected into xaml/MainWindow.xaml at the @PANELS@ marker.
  Symbols must be XML entities, never pasted raw (&#183; = middle dot).
  ==========================================================================
-->
<ScrollViewer Name="PanelProgress" Visibility="Collapsed" Padding="24,20,24,16">
    <StackPanel>
        <TextBlock Text="Progress" Style="{StaticResource H1}"/>

        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <!-- "Step N of 3" — always visible, even before the install starts -->
                <TextBlock Name="ProgressStep" Text="Step 0 of 3: Not started"
                           Style="{StaticResource Display}" Margin="0,0,0,16"/>

                <!-- Per-stage progress bar (0-100) -->
                <ProgressBar Name="ProgressBar1" Style="{StaticResource AkariProgress}" Margin="0,0,0,6"/>

                <!-- Current action text -->
                <TextBlock Name="ProgressAction" Text="Waiting to start."
                           Style="{StaticResource Label}" Margin="0"/>

                <TextBlock Name="ProgressDetail" Text=""
                           Style="{StaticResource CardDesc}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Stage roadmap (SAFE-03). Headline text is set from Get-StageExplanation
             so the copy matches the home panel and the UI-SPEC wording exactly. -->
        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="WHAT EACH STAGE DOES" Style="{StaticResource CardGroupHeader}"/>
                <TextBlock Name="Stage1Headline" Style="{StaticResource CardDesc}" Margin="0,8,0,0"
                           TextWrapping="Wrap" Text="Stage 1: Downloads required payloads, configures boot settings, and reboots into Safe Mode."/>
                <TextBlock Name="Stage2Headline" Style="{StaticResource CardDesc}" Margin="0,8,0,0"
                           TextWrapping="Wrap" Text="Stage 2: Runs in Safe Mode as TrustedInstaller. Disables Defender, modifies system protections, and reboots."/>
                <TextBlock Name="Stage3Headline" Style="{StaticResource CardDesc}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Text="Stage 3: Removes bloatware, applies performance tweaks, sets AkariOS branding, and reboots to complete."/>
            </StackPanel>
        </Border>

        <!-- Run a single stage on its own (FLOW-02). Buttons are declared DISABLED
             on purpose: main.ps1 step 6 enables them only when Get-ResumePoint
             reports a stage that is actually pending. Plain Name=, never x:Name —
             main.ps1:17 and :104 can only see the plain form. No Click= attribute
             anywhere: wiring is by the Invoke-BtnStage<N> name convention. -->
        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="RUN A SINGLE STAGE" Style="{StaticResource CardGroupHeader}"/>
                <TextBlock Style="{StaticResource CardDesc}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Runs one stage by itself instead of the full three-stage flow. Each button asks for the same confirmation token as Install AkariOS."/>

                <Button Name="BtnStage1" Content="Run Stage 1 only" Style="{StaticResource Btn}"
                        HorizontalAlignment="Left" IsEnabled="False" Margin="0,12,0,0"/>
                <Button Name="BtnStage2" Content="Run Stage 2 only" Style="{StaticResource Btn}"
                        HorizontalAlignment="Left" IsEnabled="False" Margin="0,8,0,0"/>
                <Button Name="BtnStage3" Content="Run Stage 3 only" Style="{StaticResource Btn}"
                        HorizontalAlignment="Left" IsEnabled="False" Margin="0,8,0,0"/>

                <!-- Safe Mode handoff copy (D-12, RESEARCH Finding 5). Collapsed by
                     default; revealed before Stage 2 starts and at launch when the
                     resume point is stage2.

                     The three facts below are the whole of Task 2 and they MUST
                     stay literal text in this file: Test-Panels.ps1 and the plan's
                     verify grep them here. Do not move them into code, and do not
                     shorten them - each one is a trap the user would otherwise hit
                     blind on a VM.

                       1. A maximized console window IS the engine talking. Stage 2
                          is never WPF: Safe Mode renders only through the
                          undocumented Render Tier 0 path (BasicDisplay.sys + WARP),
                          which AkariOS does not rely on (D-12).
                       2. The machine sits at a Safe Mode logon screen and STAYS
                          there. HKCU RunOnce fires at LOGON, not at boot, and
                          nothing in WinSux enables auto-logon. Without an
                          administrator sign-in at that prompt, Stage 2 never runs
                          and !steptwo never fires. AkariOS deliberately does not
                          add auto-logon either - that is a machine-state change
                          outside this phase (D-11) - so this sentence is the
                          mitigation.
                       3. DDU restarts the machine, not a shutdown call.
                          stepone.ps1 contains no shutdown at all; the transition
                          out of Safe Mode is
                          `Display Driver Uninstaller.exe ... -Restart`
                          (stepone.ps1:153). So a Stage 2 failure BEFORE DDU
                          launches leaves safeboot already cleared with no reboot
                          performed - the machine is back in normal boot with
                          !steptwo still pending. That is recoverable: the resume
                          banner on the State page picks it up. No special
                          handling is needed for it. -->
                <TextBlock Name="StageHandoffHint" Visibility="Collapsed" Margin="0,14,0,0"
                           Style="{StaticResource CardDesc}" Foreground="#FFA726" TextWrapping="Wrap"
                           Text="STAGE 2 RUNS AS A CONSOLE, NOT A WINDOW. A maximized black console window appears and it is the stage script working - it is not a hang. After Stage 1 the machine restarts into Safe Mode and stops at the Safe Mode logon screen: you must log on there as an ADMINISTRATOR, because the queued stage script starts at logon and nothing logs on for you. Safe Mode cannot draw the AkariOS window, so AkariOS itself is not running at that point - the console is the interface. Finally, Stage 2 leaves Safe Mode because Display Driver Uninstaller restarts the machine; there is no shutdown command in it. If Stage 2 stops before the driver uninstaller starts, the machine will simply come back up in normal boot with Stage 3 still queued - reopen AkariOS and the State page will show what is pending."/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardDanger}">
            <StackPanel>
                <TextBlock Text="CANCELLING" Style="{StaticResource CardGroupHeader}" Foreground="#FF6B6B"/>
                <TextBlock Name="CancelDisabledReason"
                           Text="Cancel is disabled because the machine is in a transitional state. Wait for the current step to complete."
                           Style="{StaticResource CardDesc}" Margin="0,0,0,12"/>

                <!-- Cancel button. IsEnabled is driven by Get-CanCancel: available during
                     Stage 1 only, and disabled once the first reboot is imminent (SAFE-04). -->
                <Button Name="BtnCancel" Content="Cancel Install" Style="{StaticResource Btn}"
                        HorizontalAlignment="Left" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>