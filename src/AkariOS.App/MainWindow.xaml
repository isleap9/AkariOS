<Window
    x:Class="AkariOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariOS.App"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <Grid x:Name="RootElement" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Source="{x:Bind AppIconSource}"
                    Width="40"
                    Height="40"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="TitleText"
                    Text="{x:Bind AppTitle}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Shell content -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            SelectionChanged="OnNavSelectionChanged"
            MenuItemsSource="{x:Bind MainNavItems}"
            FooterMenuItemsSource="{x:Bind FooterNavItems}">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="local:NavigationItem">
                    <NavigationViewItem Content="{x:Bind Label}" Tag="{x:Bind PageType}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <!-- Playbook steps in the nav pane (the ISO drop zone pane was removed
                 when the app went playbook-first; ISO code kept but unexposed) -->
            <NavigationView.PaneCustomContent>
                <StackPanel>
                    <!-- Brand banner (AkariOS wallpaper art), like the reference wizard -->
                    <Image Source="ms-appx:///Assets/Wallpaper.png"
                           MaxHeight="120" Stretch="UniformToFill" Margin="-1,0,-1,8" />
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" />

                <InfoBar
                    Grid.Row="1"
                    x:Name="ShellInfoBar"
                    Title="{x:Bind InfoBar.Title}"
                    Message="{x:Bind InfoBar.Message}"
                    Severity="{x:Bind InfoBar.Severity}"
                    IsClosable="{x:Bind InfoBar.IsClosable}"
                    IsOpen="{x:Bind InfoBar.IsOpen, Mode=TwoWay}" />

                <!-- Wizard footer: visible only on playbook step pages -->
                <Grid Grid.Row="2" x:Name="WizardFooter" Padding="24,12"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <Button Grid.Column="0" HorizontalAlignment="Left" Click="OnDiscordClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F2;" FontSize="16" />
                            <TextBlock Text="Akari Labs Discord" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" x:Name="BackButton" Content="Back" MinWidth="110"
                            Click="OnWizardBack" />
                    <Button Grid.Column="2" x:Name="NextButton" MinWidth="150"
                            Style="{StaticResource AccentButtonStyle}" Click="OnWizardNext" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
