<Window
    x:Class="AkariOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariOS.App"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <Grid x:Name="RootElement" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Height="40" Background="Transparent">

            <StackPanel
                Orientation="Horizontal"
                Spacing="12"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <Image
                    Source="{x:Bind AppIconSource}"
                    Width="40"
                    Height="40"
                    Stretch="Uniform" />
                <TextBlock
                    x:Name="TitleText"
                    Text="{x:Bind AppTitle}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Shell content -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="260"
            SelectionChanged="OnNavSelectionChanged"
            FooterMenuItemsSource="{x:Bind FooterNavItems}">

            <NavigationView.MenuItemTemplate>
                <DataTemplate x:DataType="local:NavigationItem">
                    <NavigationViewItem Content="{x:Bind Label}" Tag="{x:Bind PageType}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="{x:Bind Glyph}" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </DataTemplate>
            </NavigationView.MenuItemTemplate>

            <!-- The pane IS the ISO drop zone / list -->
            <NavigationView.PaneCustomContent>
                <Grid x:Name="PaneDropArea"
                      Height="{Binding}"
                      MinHeight="480">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Accepts drops anywhere in the pane -->
                    <Grid AllowDrop="True"
                          Drop="OnPaneDrop"
                          DragOver="OnPaneDragOver"
                          DragLeave="OnPaneDragLeave"
                          Background="Transparent">

                        <StackPanel Margin="12,4,12,8">
                            <TextBlock Text="ISOs"
                                       Style="{StaticResource NavigationViewItemHeaderTextStyle}" />

                            <ListView x:Name="IsoList"
                                      ItemsSource="{x:Bind ViewModel.Isos, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedIso, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      Margin="-8,0,0,0">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IsoItem">
                                        <StackPanel Padding="4" Spacing="4">
                                            <TextBlock Text="{x:Bind FileName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}"
                                                         Maximum="100" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                                       FontSize="11"
                                                       Opacity="0.7"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Shown when the list is empty -->
                            <TextBlock x:Name="PaneDropHint"
                                       Text="Drag &amp; drop&#x0a;.iso files here"
                                       TextAlignment="Center"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,24,0,0" />
                        </StackPanel>
                    </Grid>

                    <Button Content="+ Add ISO"
                            Grid.Row="1"
                            Margin="12,8,12,12"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.PickIsoCommand}" />
                </Grid>
            </NavigationView.PaneCustomContent>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Frame x:Name="ContentFrame" />

                <InfoBar
                    Grid.Row="1"
                    x:Name="ShellInfoBar"
                    Title="{x:Bind InfoBar.Title}"
                    Message="{x:Bind InfoBar.Message}"
                    Severity="{x:Bind InfoBar.Severity}"
                    IsClosable="{x:Bind InfoBar.IsClosable}"
                    IsOpen="{x:Bind InfoBar.IsOpen, Mode=TwoWay}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
