<local:WizardStepPage
    x:Class="AkariOS.App.Views.OptimizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariOS.App.Views">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Optimization" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Applying the playbook to your system."
                       Opacity="0.75" TextWrapping="Wrap" />

            <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                     Title="Engine run lands in Slice 4"
                     Message="This step will launch the bundled engine with your selected options and stream progress here." />
        </StackPanel>
    </ScrollViewer>
</local:WizardStepPage>