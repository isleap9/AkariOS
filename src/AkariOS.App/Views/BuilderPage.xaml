<Page
    x:Class="AkariOS.App.Views.BuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="{x:Bind ViewModel.SelectedIso.FileName, Mode=OneWay, FallbackValue='AkariOS'}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextTrimming="CharacterEllipsis" />

            <!-- Empty state -->
            <StackPanel Spacing="12"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibility}}">
                <FontIcon Glyph="&#xE8E5;" FontSize="40" Opacity="0.6" />
                <TextBlock Text="Drag &amp; drop a Windows ISO onto the sidebar to get started."
                           TextWrapping="Wrap"
                           Opacity="0.8" />
            </StackPanel>

            <!-- Details -->
            <StackPanel Spacing="16"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Create AkariOS ISO"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.BuildCommand}" />
                    <Button Content="Apply to this PC"
                            Command="{x:Bind ViewModel.ApplyNowCommand}" />
                    <Button Content="Cancel"
                            Command="{x:Bind ViewModel.CancelBuildCommand}" />
                </StackPanel>

                <CheckBox Content="Show engine console (debugging)"
                          IsChecked="{x:Bind ViewModel.ShowEngineConsole, Mode=TwoWay}"
                          FontSize="12" Opacity="0.8" />

                <TextBlock Text="The tweaks are applied automatically after Windows installation completes — just install normally from the generated ISO."
                           TextWrapping="Wrap"
                           Opacity="0.75" />

                <TextBlock Text="{x:Bind ViewModel.SelectedIso.Status, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontSize="13" />

                <!-- Edition picker (only shown when the WIM has 2+ editions) -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.SelectedIso.EditionsVisibility, Mode=OneWay}">
                    <TextBlock Text="Editions to tweak" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedIso.Editions, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditionItem">
                                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="Unticked editions are left untouched in the output ISO."
                               FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>

                <Expander Header="Build log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                  x:Name="LogScroller">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedIso.LogLines, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12"
                                               TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                                               Opacity="0.85" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Expander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
