<Page
    x:Class="AkariOS.App.Views.BuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar: drop ISOs here -->
            <ColumnDefinition Width="260" />
            <!-- Main area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                AllowDrop="True"
                Drop="OnDrop"
                DragOver="OnDragOver"
                DragLeave="OnDragLeave">
            <Grid RowSpacing="8" Padding="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="ISOs"
                           Style="{StaticResource NavigationViewItemHeaderTextStyle}"
                           Margin="8,4,0,0" />

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Isos}"
                          SelectedItem="{x:Bind ViewModel.SelectedIso, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:IsoItem">
                            <StackPanel Padding="4" Spacing="4" RightTapped="OnItemRightTapped" Tag="{x:Bind Path}">
                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Button Grid.Row="2"
                        Content="+ Add ISO"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PickIsoCommand}" />

                <!-- Drop hint overlay -->
                <Border x:Name="DropHint"
                        Grid.RowSpan="3"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <TextBlock Text="Drop ISO to add"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN AREA ==================== -->
        <ScrollViewer Grid.Column="1" Padding="32,24">
            <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock Text="{x:Bind ViewModel.SelectedIso.FileName, Mode=OneWay, FallbackValue='AkariOS'}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />

                <!-- Empty state -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource InvertedBooleanToVisibility}}">
                    <FontIcon Glyph="&#xE8E5;" FontSize="40" Opacity="0.6" />
                    <TextBlock Text="Drag &amp; drop a Windows ISO into the sidebar to get started."
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                </StackPanel>

                <!-- Details -->
                <StackPanel Spacing="16"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}">
                    <Button Content="Create AkariOS ISO"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.BuildCommand}" />

                    <TextBlock Text="The tweaks are applied automatically after Windows installation completes — just install normally from the generated ISO."
                               TextWrapping="Wrap"
                               Opacity="0.75" />

                    <TextBlock Text="{x:Bind ViewModel.SelectedIso.Status, Mode=OneWay}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
