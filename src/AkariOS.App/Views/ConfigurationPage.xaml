<local:WizardStepPage
    x:Class="AkariOS.App.Views.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariOS.App.Views">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Configuration" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Customize how the playbook will be applied to your system."
                       Opacity="0.75" TextWrapping="Wrap" />

            <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                     Title="Options land in Slice 3"
                     Message="The playbook's FeaturePages (security, settings, removals, extras) will be rendered here." />
        </StackPanel>
    </ScrollViewer>
</local:WizardStepPage>