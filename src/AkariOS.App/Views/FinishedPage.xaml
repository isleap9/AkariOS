<local:WizardStepPage
    x:Class="AkariOS.App.Views.FinishedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariOS.App.Views">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Finished" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="System configuration complete."
                       Opacity="0.75" TextWrapping="Wrap" />

            <InfoBar IsOpen="True" Severity="Success" IsClosable="False"
                     Title="AkariOS playbook applied"
                     Message="Your system has been configured. A restart is recommended to finalize all changes." />

            <Button Content="Restart now" Click="OnRestartClick" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</local:WizardStepPage>