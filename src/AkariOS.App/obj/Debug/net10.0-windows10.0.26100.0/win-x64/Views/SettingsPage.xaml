<Page x:ConnectionId='1'
    x:Class="AkariOS.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">

            <TextBlock x:ConnectionId='2'
                                                                          
                Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Appearance -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16"
                MaxWidth="480">
                <StackPanel Spacing="12">
                    <TextBlock x:ConnectionId='8'                                                                 Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ComboBox x:ConnectionId='9'
                                                                                    
                        ItemsSource="{Binding Themes}"
                        SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox x:ConnectionId='10'
                                                                                       
                        Width="220"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Cultures}"
                        DisplayMemberPath="DisplayName"
                        SelectedItem="{Binding SelectedCulture, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="16"
                MaxWidth="480">
                <StackPanel Spacing="8">
                    <TextBlock x:ConnectionId='3'                                                            Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBlock x:ConnectionId='4'                         />
                    <TextBlock x:ConnectionId='5'                                />
                    <TextBlock x:ConnectionId='6'
                        TextWrapping="Wrap"
                                                                                              />
                    <TextBlock x:ConnectionId='7'
                        TextWrapping="Wrap"
                        Opacity="0.8"
                                                         />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

