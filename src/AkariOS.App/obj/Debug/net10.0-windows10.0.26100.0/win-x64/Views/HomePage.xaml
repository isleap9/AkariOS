<Page x:ConnectionId='1'
    x:Class="AkariOS.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">

            <TextBlock
                Text="App Template"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock x:ConnectionId='2'
                TextWrapping="Wrap"
                Opacity="0.8"
                                                                          />

            <StackPanel
                Margin="0,12,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <Button x:ConnectionId='3'                                                                  Command="{Binding OpenSettingsCommand}" />
                <Button x:ConnectionId='4'                                                           Command="{Binding ShowAboutCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

