{
    "Name":  "AkariOS",
    "Description":  "The full AkariOS setup, as One-click does it: preparation, then Safe Mode (Windows Security and drivers), then the debloat (everything but the keep-lists), its apps and every Tweak marked AkariOS. Akari restarts the PC between phases.",
    "Phases":  [
                   {
                       "Name":  "Preparation: apps and tools",
                       "Boot":  "Normal",
                       "Tweaks":  [
                                      "install-7-zip",
                                      "install-vcredist",
                                      "install-helium",
                                      "install-directx",
                                      "oneclick-ddu-prepare",
                                      "oneclick-allow-scripts",
                                      "system-terminal-not-default"
                                  ]
                   },
                   {
                       "Name":  "Safe Mode: Windows Security, UAC and drivers",
                       "Boot":  "SafeMode",
                       "Tweaks":  [
                                      "security-defender-settings",
                                      "security-uac-off",
                                      "oneclick-ddu-clean"
                                  ]
                   },
                   {
                       "Name":  "Debloat and tweaks",
