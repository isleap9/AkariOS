<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AkariOS" Width="488" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontText}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Tx}">
  <!-- Akari's dialog (UI\Dialog.ps1): a raised card over the dimmed window, the design system's Dialog: an icon blob
       beside the Unbounded title, the text (an optional text box under it), then the buttons: ghost ones and the
       crimson main action last. The 20 px margin leaves room for the shadow. Styles and brushes come from the main
       window's resources. -->
  <Border Margin="20" Background="{DynamicResource S2}" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="20">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" Opacity="0.5" ShadowDepth="8" Direction="270"/>
    </Border.Effect>
    <Grid Margin="24,22,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel>
        <Border x:Name="DlgIcon" Width="40" Height="40" CornerRadius="12" Margin="0,0,14,0" VerticalAlignment="Center"
                Background="{DynamicResource AccSoft}">
          <Viewbox Width="22" Height="22">
            <Canvas Width="24" Height="24">
              <Path x:Name="DlgIconPath" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </Border>
        <TextBlock x:Name="DlgTitle" FontFamily="{DynamicResource FontDisplay}" FontSize="18" FontWeight="SemiBold"
                   VerticalAlignment="Center" TextWrapping="Wrap" Background="Transparent"/>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,16,0,0">
        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="DlgText" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource Mu}"/>
        </ScrollViewer>
        <TextBox x:Name="DlgInput" Style="{DynamicResource Flat}" Margin="0,14,0,0" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel x:Name="DlgButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"/>
    </Grid>
  </Border>
</Window>
