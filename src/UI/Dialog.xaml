<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AkariOS" Width="472" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontText}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Tx}">
  <!-- Akari's dialog (UI\Dialog.ps1), after Win11Debloat's message box: a dark card over the dimmed window, a
       title, an icon next to the text (an optional text box under it), the buttons on a darker strip. The 16 px
       margin leaves room for the shadow. Styles and brushes come from the main window's resources. -->
  <Border Margin="16" Background="{DynamicResource S2}" BorderBrush="{DynamicResource Bd}" BorderThickness="1" CornerRadius="8">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" Opacity="0.5" ShadowDepth="4" Direction="270"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock x:Name="DlgTitle" Margin="20,16,20,0" FontFamily="{DynamicResource FontDisplay}" FontSize="16" FontWeight="SemiBold" Background="Transparent"/>
      <Grid Grid.Row="1" Margin="20,12,20,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="DlgIcon" FontFamily="{DynamicResource Icons}" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1">
          <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="DlgText" TextWrapping="Wrap" LineHeight="21"/>
          </ScrollViewer>
          <TextBox x:Name="DlgInput" Style="{DynamicResource Flat}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0"
              CornerRadius="0,0,8,8" Padding="20,12">
        <StackPanel x:Name="DlgButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
      </Border>
    </Grid>
  </Border>
</Window>
