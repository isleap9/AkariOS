<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AkariOS" Width="800" Height="600" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontText}" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource Tx}">
  <!-- Akari's dialog (UI\Dialog.ps1), WinUI's ContentDialog (the prototype's .smoke / .dlg): it covers the main window
       with a 30 % black smoke (DlgSmoke) and centres a 448 px S2 card with a Fly stroke and 8 px corners: the title in
       Subtitle, the text and its list of consequences, then a footer strip on Bg with equal-width buttons, the accent
       action first. Esc and a click on the smoke cancel. Styles and brushes come from the main window's resources. -->
  <!-- the Motion tokens go in here (Get-AkariXaml) -->
  <Window.Resources>
  </Window.Resources>
  <Grid>
    <Border x:Name="DlgSmoke" Background="{DynamicResource Scrim}"/>
    <Border x:Name="DlgCard" Width="448" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource S2}"
            BorderBrush="{DynamicResource Fly}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
      <Border.Effect><DropShadowEffect Color="{DynamicResource ShadeDlg}" BlurRadius="64" ShadowDepth="32" Direction="270" Opacity="1"/></Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24">
          <TextBlock x:Name="DlgTitle" FontFamily="{DynamicResource FontDisplay}" FontSize="20" LineHeight="28" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,0,0,12" Background="Transparent"/>
          <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DlgText"/>
          </ScrollViewer>
          <TextBox x:Name="DlgInput" Style="{DynamicResource Flat}" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Div}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="24">
          <UniformGrid x:Name="DlgButtons" Rows="1"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
