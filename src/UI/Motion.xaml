<!-- AkariOS motion tokens (plan docs/plans/2026-10-31-motion-polish.md, values from the Windows 11 style plan
     docs/plans/2026-11-17-windows-11-style.md): every animation's duration and easing, WinUI's.
     Get-AkariXaml (UI\Motion.ps1) copies these entries into each XAML file's resources before parsing, so styles and
     templates use them through StaticResource (storyboards in templates are frozen: no DynamicResource); with Windows'
     animation effects off it writes every Duration as 0:0:0. Start-AkariMotion reads the same values.
     Entries use the presentation namespace only (they are pasted into files that declare nothing else). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- hover, press (WinUI's ControlFasterAnimationDuration) -->
  <Duration x:Key="Motion.Fast">0:0:0.083</Duration>
  <!-- switches, checks, popups (ControlNormalAnimationDuration) -->
  <Duration x:Key="Motion.Base">0:0:0.167</Duration>
  <!-- pages, dialogs -->
  <Duration x:Key="Motion.Slow">0:0:0.25</Duration>
  <!-- the delay between cards that appear one after another -->
  <Duration x:Key="Motion.Stagger">0:0:0.03</Duration>
  <!-- Fluent's decelerate curve, close to cubic-bezier(0, 0, 0, 1): fast out, a long soft landing, no overshoot -->
  <ExponentialEase x:Key="Motion.Ease" EasingMode="EaseOut" Exponent="7"/>
  <!-- the native app's views until they move to the Windows 11 style (plan batch 7); the PowerShell UI never uses it
       (Fluent has no overshoot) -->
  <BackEase x:Key="Motion.Spring" EasingMode="EaseOut" Amplitude="0.3"/>
</ResourceDictionary>
