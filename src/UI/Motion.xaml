<!-- AkariOS motion tokens (plan docs/plans/2026-10-31-motion-polish.md): every animation's duration and easing.
     Get-AkariXaml (UI\Motion.ps1) copies these entries into each XAML file's resources before parsing, so styles and
     templates use them through StaticResource (storyboards in templates are frozen: no DynamicResource); with Windows'
     animation effects off it writes every Duration as 0:0:0. Start-AkariMotion reads the same values.
     Entries use the presentation namespace only (they are pasted into files that declare nothing else). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- hover, press -->
  <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
  <!-- switches, checks, tabs, popups -->
  <Duration x:Key="Motion.Base">0:0:0.2</Duration>
  <!-- pages, dialogs -->
  <Duration x:Key="Motion.Slow">0:0:0.28</Duration>
  <!-- the delay between cards that appear one after another -->
  <Duration x:Key="Motion.Stagger">0:0:0.03</Duration>
  <CubicEase x:Key="Motion.Ease" EasingMode="EaseOut"/>
  <!-- the switch thumb only: a slight overshoot -->
  <BackEase x:Key="Motion.Spring" EasingMode="EaseOut" Amplitude="0.3"/>
</ResourceDictionary>
