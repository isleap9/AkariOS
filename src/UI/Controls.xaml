<!-- AkariOS controls (the design system's): pill switches, check boxes, radio buttons, a pill combobox and a segmented
     picker, the crimson accent button, setting / category / mode cards and step dots. Theme brushes only
     (DynamicResource, UI\Theme.Dark.xaml / Theme.Light.xaml); the focus rings (FocusRing, FocusBox) and the window's
     own styles are in UI\MainWindow.xaml. Merged into the window's resources by UI\Shell.ps1 (through Get-AkariXaml,
     which adds the Motion tokens).
     Motion (UI\Motion.xaml): a state's colour is a layer whose Opacity fades (brushes are shared and never animated),
     sizes and positions are transforms; each animated value belongs to one trigger, so triggers never fight over it
     (the switch thumb has one transform per trigger: size, hover, press, middle, on). A trigger true when the control
     loads plays its animation then (a switch already on slides into place). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Toggle switch: "Off" / "On" / "Unchanged" label, then a 48 x 28 pill with a 2 px stroke.
       Three-state (IsThreeState) for a Tweak whose State is Unknown or Custom: null = no change, dashed track.
       Thumb: a 20 px disc at 4 px from the left, transforms [0] size (0.8 off, 1 on), [1] hover, [2] press stretch,
       [3] middle (+10 px, Unchanged), [4] on (+20 px). -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="L" Text="Off" Width="88" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"/>
            <Grid Width="48" Height="28" VerticalAlignment="Center">
              <Rectangle x:Name="Track" RadiusX="14" RadiusY="14" StrokeThickness="2" Stroke="{DynamicResource Mu}" Fill="{DynamicResource Ctl}"/>
              <Rectangle x:Name="Hover" Margin="2" RadiusX="12" RadiusY="12" Fill="{DynamicResource CtlH}" Opacity="0"/>
              <Rectangle x:Name="On" RadiusX="14" RadiusY="14" StrokeThickness="2" Stroke="{DynamicResource Acc}" Fill="{DynamicResource Acc}" Opacity="0"/>
              <Grid x:Name="Thumb" Width="20" Height="20" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                    <ScaleTransform/>
                    <ScaleTransform/>
                    <TranslateTransform/>
                    <TranslateTransform/>
                  </TransformGroup>
                </Grid.RenderTransform>
                <Ellipse Fill="{DynamicResource Mu}"/>
                <Ellipse x:Name="ThumbOn" Fill="{DynamicResource AccT}" Opacity="0"/>
              </Grid>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1.1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1.1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="L" Property="Text" Value="On"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ThumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[4].(TranslateTransform.X)" To="20" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ThumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.8" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.8" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[4].(TranslateTransform.X)" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="L" Property="Text" Value="Unchanged"/>
              <Setter TargetName="L" Property="Foreground" Value="{DynamicResource Mu}"/>
              <Setter TargetName="Track" Property="StrokeDashArray" Value="2 2"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" To="10" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleX)" To="1.2" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Catalogue switch (Optimize › Advanced): the 48 x 28 pill alone, the card's State line says the rest. Null (State
       Custom or Unknown) = thumb in the middle, dashed track. The same track and thumb as Switch. -->
  <Style x:Key="CatSwitch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Width="48" Height="28" Background="Transparent" VerticalAlignment="Center">
            <Rectangle x:Name="Track" RadiusX="14" RadiusY="14" StrokeThickness="2" Stroke="{DynamicResource Mu}" Fill="{DynamicResource Ctl}"/>
            <Rectangle x:Name="Hover" Margin="2" RadiusX="12" RadiusY="12" Fill="{DynamicResource CtlH}" Opacity="0"/>
            <Rectangle x:Name="On" RadiusX="14" RadiusY="14" StrokeThickness="2" Stroke="{DynamicResource Acc}" Fill="{DynamicResource Acc}" Opacity="0"/>
            <Grid x:Name="Thumb" Width="20" Height="20" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TransformGroup>
                  <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                  <ScaleTransform/>
                  <ScaleTransform/>
                  <TranslateTransform/>
                  <TranslateTransform/>
                </TransformGroup>
              </Grid.RenderTransform>
              <Ellipse Fill="{DynamicResource Mu}"/>
              <Ellipse x:Name="ThumbOn" Fill="{DynamicResource AccT}" Opacity="0"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1.1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1.1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ThumbOn" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[4].(TranslateTransform.X)" To="20" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ThumbOn" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.8" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.8" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[4].(TranslateTransform.X)" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Track" Property="StrokeDashArray" Value="2 2"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" To="10" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleX)" To="1.2" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkbox: a 22 px box, 6 px corners, 2 px stroke; Acc fill and an AccT tick when checked (the tick pops in). -->
  <Style x:Key="Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusBox}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- box, then the label in the remaining width (a long label wraps) -->
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="Box" Width="22" Height="22" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
              <Border CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Mu}" Background="{DynamicResource Ctl}"/>
              <Border x:Name="Hover" Margin="2" CornerRadius="4" Background="{DynamicResource CtlH}" Opacity="0"/>
              <Border x:Name="On" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Acc}" Background="{DynamicResource Acc}" Opacity="0"/>
              <Viewbox x:Name="Tick" Width="14" Height="14" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6"/></Viewbox.RenderTransform>
                <Canvas Width="24" Height="24">
                  <Path Data="{DynamicResource Ic.check}" Stroke="{DynamicResource AccT}" StrokeThickness="3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.6" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.6" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                    <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Radio button: a 22 px ring (2 px) that fills Acc with an AccT dot when picked (the dot grows in); the label wraps -->
  <Style x:Key="Radio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="22" Height="22" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="{DynamicResource Mu}" Fill="{DynamicResource Ctl}"/>
              <Ellipse x:Name="Hover" Margin="2" Fill="{DynamicResource CtlH}" Opacity="0"/>
              <Ellipse x:Name="On" StrokeThickness="2" Stroke="{DynamicResource Acc}" Fill="{DynamicResource Acc}" Opacity="0"/>
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccT}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Combobox: a 36 px pill with a chevron (it turns over while open); the drop-down is a raised S2 panel with 12 px
       corners, rows with 8 px corners and the crimson bar on the picked one. Editable keeps the same look. -->
  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Margin="4,1" Background="Transparent">
            <Border x:Name="H" CornerRadius="8" Background="{DynamicResource CtlH}" Opacity="0"/>
            <Border x:Name="S" CornerRadius="8" Background="{DynamicResource AccSoft}" Opacity="0"/>
            <Border x:Name="B" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource Acc}" Opacity="0" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform ScaleY="0"/></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="S" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Combo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Field" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                    <Border CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource CtlBd}" Background="{DynamicResource Ctl}"/>
                    <Border x:Name="Hover" CornerRadius="17" Margin="1" Background="{DynamicResource CtlH}" Opacity="0"/>
                    <Border x:Name="Open" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource Acc}" Background="{DynamicResource CtlP}" Opacity="0"/>
                    <Viewbox x:Name="Chev" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                      <Viewbox.RenderTransform><RotateTransform/></Viewbox.RenderTransform>
                      <Canvas Width="24" Height="24">
                        <Path Data="{DynamicResource Ic.chevron-down}" Stroke="{DynamicResource Mu}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                      </Canvas>
                    </Viewbox>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Trigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.EnterActions>
                      <Trigger.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Trigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Open" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                            <DoubleAnimation Storyboard.TargetName="Chev" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.EnterActions>
                      <Trigger.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Open" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                            <DoubleAnimation Storyboard.TargetName="Chev" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </Trigger.ExitActions>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="16,0,38,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="13,0,38,0" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tx}" CaretBrush="{DynamicResource Tx}"
                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Margin="0,6,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" CornerRadius="12" Padding="0,4"
                      Background="{DynamicResource S2}" BorderBrush="{DynamicResource Bd}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Shown" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented picker: a Choice with up to 4 values (UI\Cards.ps1 picks it over Combo), and Optimize's Sections. A
       ListBox of ListBoxItems (never ComboBoxItems: they ignore clicks outside a ComboBox), so the row code is the
       same as a Combo's: a pill track, the picked segment crimson: one Pill under the items slides and stretches to the
       picked one (Update-AkariSegmentPill, UI\Motion.ps1, hooked on every ListBox). Segments wrap onto a second line
       when the card is narrow; the pill follows them there. -->
  <Style x:Key="SegItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Padding" Value="12,5,12,6"/>
    <Setter Property="Margin" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent">
            <Border x:Name="H" CornerRadius="15" Background="{DynamicResource CtlH}" Opacity="0"/>
            <Border x:Name="B" CornerRadius="15" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <!-- the picked one: light text over the Segmented's sliding pill, no hover tint under it -->
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource AccT}"/>
              <Setter TargetName="H" Property="Visibility" Value="Hidden"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Background" Value="{DynamicResource Ctl}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource SegItem}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="18" Padding="2" HorizontalAlignment="Left">
            <Grid>
              <!-- the picked segment's pill, placed over it by Update-AkariSegmentPill (hidden until placed) -->
              <Canvas IsHitTestVisible="False">
                <Border x:Name="Pill" Width="0" Height="0" CornerRadius="15" Background="{DynamicResource Acc}" Visibility="Hidden"/>
              </Canvas>
              <ItemsPresenter/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Setting card: a Review / result row (blob, name, the change or Outcome), a Catalogue TweakRow, an About or
       Unattend Generator section. 14 px corners. -->
  <Style x:Key="SettingCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource S1}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="18,14"/>
    <Setter Property="MinHeight" Value="64"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <!-- Category card: one Category in the Guided Tweaks grid: icon blob, title and count pill, then its rows with
       dashed rules between them (UI\Cards.ps1). -->
  <Style x:Key="CategoryCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource S1}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="20,16,20,12"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- Accent button (Next, Apply): the crimson pill with the lamp glow, as BtnP (UI\MainWindow.xaml). The glow sits
       on its own layer (cached) under the hover / press layers, so a fade never redraws the shadow; hover lifts the
       pill 1 px, press shrinks it a little. -->
  <Style x:Key="Accent" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource AccT}"/>
    <Setter Property="Background" Value="{DynamicResource Acc}"/>
    <Setter Property="Padding" Value="22,7,22,8"/>
    <Setter Property="MinWidth" Value="104"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TransformGroup>
                <ScaleTransform/>
                <TranslateTransform/>
              </TransformGroup>
            </Grid.RenderTransform>
            <Border x:Name="Glow" Background="{TemplateBinding Background}" CornerRadius="18">
              <Border.CacheMode><BitmapCache/></Border.CacheMode>
              <Border.Effect>
                <DropShadowEffect Color="{DynamicResource AccC}" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.35"/>
              </Border.Effect>
            </Border>
            <Border x:Name="H" CornerRadius="18" Background="{DynamicResource AccH}" Opacity="0"/>
            <Border x:Name="P" CornerRadius="18" Background="{DynamicResource AccP}" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.97" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.97" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
              <Setter TargetName="Glow" Property="Effect" Value="{x:Null}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mode card (the Home tiles, Install AkariOS and Optimize choosers): a poster card, 20 px corners, an arrow
       bottom right; on hover the card lifts 3 px, the border lightens and the arrow turns crimson and nudges right.
       ModeCardHot = the recommended one: a crimson border and the lamp glow. -->
  <Style x:Key="ModeCard" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusBox}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" MinHeight="200" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <TransformGroup>
                <ScaleTransform/>
                <TranslateTransform/>
              </TransformGroup>
            </Grid.RenderTransform>
            <Border x:Name="B" Background="{DynamicResource S1}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="20"/>
            <Border x:Name="P" Margin="1" CornerRadius="19" Background="{DynamicResource S2}" Opacity="0"/>
            <Border x:Name="HB" BorderBrush="{DynamicResource Mu}" BorderThickness="1" CornerRadius="20" Opacity="0"/>
            <Grid Margin="28,24">
              <ContentPresenter VerticalAlignment="Top"/>
              <Viewbox x:Name="Arrow" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Viewbox.RenderTransform><TranslateTransform/></Viewbox.RenderTransform>
                <Canvas Width="24" Height="24">
                  <Path Data="{DynamicResource Ic.arrow-right}" Stroke="{DynamicResource Mu}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  <Path x:Name="ArrowHot" Data="{DynamicResource Ic.arrow-right}" Stroke="{DynamicResource AccText}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0"/>
                </Canvas>
              </Viewbox>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HB" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ArrowHot" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="3" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-3" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HB" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="ArrowHot" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="0.98" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="0.98" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.Ease}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
              <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ModeCardHot" TargetType="Button" BasedOn="{StaticResource ModeCard}">
    <Setter Property="BorderBrush" Value="{DynamicResource Acc}"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="{DynamicResource AccC}" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.25"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Stepper number (the Guided footer, UI\Steps.ps1): an outlined circle with the step's number; Tag="Current"
       fills it crimson, Tag="Done" turns it soft crimson (it holds a check); either pops in. -->
  <Style x:Key="StepNum" TargetType="Border">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Mu}"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="RenderTransform">
      <Setter.Value><ScaleTransform/></Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Current">
        <Setter Property="Background" Value="{DynamicResource Acc}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Acc}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccT}"/>
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.7" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.7" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Fast}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="Tag" Value="Done">
        <Setter Property="Background" Value="{DynamicResource AccSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccSoft}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccText}"/>
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.85" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.85" To="1" Duration="{StaticResource Motion.Base}" EasingFunction="{StaticResource Motion.Spring}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Fast}"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
