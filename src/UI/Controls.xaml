<!-- AkariOS controls (the design system's): pill switches, check boxes, radio buttons, a pill combobox and a segmented
     picker, the crimson accent button, setting / category / mode cards and step dots. Theme brushes only
     (DynamicResource, UI\Theme.Dark.xaml / Theme.Light.xaml); the focus rings (FocusRing, FocusBox) and the window's
     own styles are in UI\MainWindow.xaml. Merged into the window's resources by UI\Shell.ps1. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Toggle switch: "Off" / "On" / "Unchanged" label, then a 48 x 28 pill with a 2 px stroke.
       Three-state (IsThreeState) for a Tweak whose State is Unknown or Custom: null = no change, dashed track. -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="L" Text="Off" Width="88" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"/>
            <Grid Width="48" Height="28" VerticalAlignment="Center">
              <Rectangle x:Name="Track" RadiusX="14" RadiusY="14" StrokeThickness="2" Stroke="{DynamicResource Mu}" Fill="{DynamicResource Ctl}"/>
              <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="6,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource Mu}"/>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="18"/>
              <Setter TargetName="Thumb" Property="Height" Value="18"/>
              <Setter TargetName="Thumb" Property="Margin" Value="5,0"/>
              <Setter TargetName="Track" Property="Fill" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="L" Property="Text" Value="On"/>
              <Setter TargetName="Track" Property="Fill" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Track" Property="Stroke" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccT}"/>
              <Setter TargetName="Thumb" Property="Width" Value="20"/>
              <Setter TargetName="Thumb" Property="Height" Value="20"/>
              <Setter TargetName="Thumb" Property="Margin" Value="4,0"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="L" Property="Text" Value="Unchanged"/>
              <Setter TargetName="L" Property="Foreground" Value="{DynamicResource Mu}"/>
              <Setter TargetName="Track" Property="StrokeDashArray" Value="2 2"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="24"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Catalogue switch (Optimize › Advanced): the 48 x 28 pill alone, the card's State line says the rest. Null (State
       Custom or Unknown) = thumb in the middle, dashed track. -->
  <Style x:Key="CatSwitch" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Width="48" Height="28" Background="Transparent" VerticalAlignment="Center">
            <Rectangle x:Name="Track" RadiusX="14" RadiusY="14" StrokeThickness="2" Stroke="{DynamicResource Mu}" Fill="{DynamicResource Ctl}"/>
            <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="6,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{DynamicResource Mu}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="18"/>
              <Setter TargetName="Thumb" Property="Height" Value="18"/>
              <Setter TargetName="Thumb" Property="Margin" Value="5,0"/>
              <Setter TargetName="Track" Property="Fill" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Fill" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Track" Property="Stroke" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccT}"/>
              <Setter TargetName="Thumb" Property="Width" Value="20"/>
              <Setter TargetName="Thumb" Property="Height" Value="20"/>
              <Setter TargetName="Thumb" Property="Margin" Value="4,0"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Track" Property="StrokeDashArray" Value="2 2"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="24"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkbox: a 22 px box, 6 px corners, 2 px stroke; Acc fill and an AccT tick when checked. -->
  <Style x:Key="Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusBox}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- box, then the label in the remaining width (a long label wraps) -->
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" BorderThickness="2"
                    BorderBrush="{DynamicResource Mu}" Background="{DynamicResource Ctl}" VerticalAlignment="Center">
              <Viewbox x:Name="Tick" Width="14" Height="14" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="{DynamicResource Ic.check}" Stroke="{DynamicResource AccT}" StrokeThickness="3"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Radio button: a 22 px ring (2 px) that fills Acc with an AccT dot when picked; the label wraps -->
  <Style x:Key="Radio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="22" Height="22" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" StrokeThickness="2" Stroke="{DynamicResource Mu}" Fill="{DynamicResource Ctl}"/>
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccT}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Acc}"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Combobox: a 36 px pill with a chevron; the drop-down is a raised S2 panel with 12 px corners, rows with 8 px
       corners and the crimson bar on the picked one. Editable keeps the same look. -->
  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Margin="4,1">
            <Border x:Name="B" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource Acc}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource AccSoft}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Combo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Field" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="B" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource CtlBd}" Background="{DynamicResource Ctl}">
                    <Viewbox Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                      <Canvas Width="24" Height="24">
                        <Path Data="{DynamicResource Ic.chevron-down}" Stroke="{DynamicResource Mu}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                      </Canvas>
                    </Viewbox>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                      <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="16,0,38,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="13,0,38,0" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tx}" CaretBrush="{DynamicResource Tx}"
                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Margin="0,6,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" CornerRadius="12" Padding="0,4"
                      Background="{DynamicResource S2}" BorderBrush="{DynamicResource Bd}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Shown" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented picker: a Choice with up to 4 values (UI\Cards.ps1 picks it over Combo), and Optimize's Sections. A
       ListBox of ListBoxItems (never ComboBoxItems: they ignore clicks outside a ComboBox), so the row code is the
       same as a Combo's: a pill track, the picked
       segment crimson. Segments wrap onto a second line when the card is narrow. -->
  <Style x:Key="SegItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Padding" Value="12,5,12,6"/>
    <Setter Property="Margin" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="B" CornerRadius="15" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource Acc}"/>
              <Setter Property="Foreground" Value="{DynamicResource AccT}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Segmented" TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Background" Value="{DynamicResource Ctl}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource SegItem}"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="18" Padding="2" HorizontalAlignment="Left">
            <ItemsPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Setting card: a Review / result row (blob, name, the change or Outcome), a Catalogue TweakRow, an About or
       Install USB section. 14 px corners. -->
  <Style x:Key="SettingCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource S1}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="18,14"/>
    <Setter Property="MinHeight" Value="64"/>
    <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>

  <!-- Category card: one Category in the Guided Tweaks grid: icon blob, title and count pill, then its rows with
       dashed rules between them (UI\Cards.ps1). -->
  <Style x:Key="CategoryCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource S1}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="20,16,20,12"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <!-- Accent button (Next, Apply): the crimson pill with the lamp glow, as BtnP (UI\MainWindow.xaml). -->
  <Style x:Key="Accent" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource AccT}"/>
    <Setter Property="Background" Value="{DynamicResource Acc}"/>
    <Setter Property="Padding" Value="22,7,22,8"/>
    <Setter Property="MinWidth" Value="104"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
            <Border.Effect>
              <DropShadowEffect Color="{DynamicResource AccC}" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.35"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource AccH}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource AccP}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="B" Property="Opacity" Value="0.35"/>
              <Setter TargetName="B" Property="Effect" Value="{x:Null}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mode card (the Home tiles, Install AkariOS and Optimize choosers): a poster card, 20 px corners, an arrow
       bottom right; lighter border and the arrow in crimson on hover. ModeCardHot = the recommended one: a crimson
       border and the lamp glow. -->
  <Style x:Key="ModeCard" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusBox}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{DynamicResource S1}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="20" Padding="28,24" MinHeight="200">
            <Grid>
              <ContentPresenter VerticalAlignment="Top"/>
              <Viewbox x:Name="Arrow" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Canvas Width="24" Height="24">
                  <Path x:Name="ArrowPath" Data="{DynamicResource Ic.arrow-right}" Stroke="{DynamicResource Mu}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
              </Viewbox>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Mu}"/>
              <Setter TargetName="ArrowPath" Property="Stroke" Value="{DynamicResource AccText}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource S2}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="B" Property="Opacity" Value="0.5"/>
              <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ModeCardHot" TargetType="Button" BasedOn="{StaticResource ModeCard}">
    <Setter Property="BorderBrush" Value="{DynamicResource Acc}"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect Color="{DynamicResource AccC}" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.25"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Stepper number (the Guided footer, UI\Steps.ps1): an outlined circle with the step's number; Tag="Current"
       fills it crimson, Tag="Done" turns it soft crimson (it holds a check). -->
  <Style x:Key="StepNum" TargetType="Border">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Mu}"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Current">
        <Setter Property="Background" Value="{DynamicResource Acc}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Acc}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccT}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Done">
        <Setter Property="Background" Value="{DynamicResource AccSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccSoft}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccText}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
