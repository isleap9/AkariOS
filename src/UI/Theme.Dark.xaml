<!-- AkariOS dark theme: every brush the UI uses, swapped as a whole by Set-AkariTheme (UI\Shell.ps1).
     WinUI 3 values (plan docs/plans/2026-11-19-winui-3.md, prototype docs/design/akarios-prototype.html).
     Acc* are Akari crimson; Set-AkariAccent replaces them when Settings follows the Windows accent.
     Keep Theme.Dark.xaml and Theme.Light.xaml on the same keys. Shade* are Colors (DropShadowEffect). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg"       Color="#202020"/> <!-- Window background without Mica (Windows 10), the dialog's button strip, the Guided footer -->
  <SolidColorBrush x:Key="Tint"     Color="#00202020"/> <!-- Window body over Mica on Windows 11: clear, Mica itself shows (as WinUI's MicaBackdrop; Surf is the content layer) -->
  <SolidColorBrush x:Key="Surf"     Color="#4D3A3A3A"/> <!-- The content layer right of the navigation pane -->
  <SolidColorBrush x:Key="S1"       Color="#0DFFFFFF"/> <!-- Settings cards, expanders, tiles -->
  <SolidColorBrush x:Key="S1Alt"    Color="#08FFFFFF"/> <!-- Nested rows inside an expander; a card while pressed -->
  <SolidColorBrush x:Key="S2"       Color="#2C2C2C"/> <!-- Flyouts, menus, drop-downs, dialogs, toasts -->
  <SolidColorBrush x:Key="Bd"       Color="#1A000000"/> <!-- 1px card stroke -->
  <SolidColorBrush x:Key="Div"      Color="#15FFFFFF"/> <!-- Dividers between rows, the content layer's edge, the dialog footer rule -->
  <SolidColorBrush x:Key="Fly"      Color="#66757575"/> <!-- 1px stroke of flyouts, menus, dialogs and toasts -->
  <SolidColorBrush x:Key="Tx"       Color="#FFFFFF"/> <!-- Primary text and icons -->
  <SolidColorBrush x:Key="Mu"       Color="#C8FFFFFF"/> <!-- Secondary text: descriptions, icons in rows -->
  <SolidColorBrush x:Key="Ter"      Color="#8BFFFFFF"/> <!-- Tertiary text (12px+): ids, versions, placeholders -->
  <SolidColorBrush x:Key="TxDis"    Color="#5DFFFFFF"/> <!-- Disabled text and icons -->
  <SolidColorBrush x:Key="Acc"      Color="#FF6B7D"/> <!-- Accent fill (Akari crimson): accent buttons, on toggles, checks, radios, the nav indicator, progress -->
  <SolidColorBrush x:Key="AccH"     Color="#E6FF6B7D"/> <!-- Accent fill on hover (90%) -->
  <SolidColorBrush x:Key="AccP"     Color="#CCFF6B7D"/> <!-- Accent fill pressed (80%) -->
  <SolidColorBrush x:Key="AccT"     Color="#000000"/> <!-- Text and glyphs on the accent fill -->
  <SolidColorBrush x:Key="AccBd"    Color="#14FFFFFF"/> <!-- Accent button stroke (top and sides) -->
  <SolidColorBrush x:Key="AccBd2"   Color="#66000000"/> <!-- Accent button stroke, bottom edge -->
  <SolidColorBrush x:Key="AccText"  Color="#FFA3AE"/> <!-- Accent as text: links, tile footers, the selected nav icon -->
  <SolidColorBrush x:Key="AccSoft"  Color="#1FFF6B7D"/> <!-- Accent tint: tile icon squares, the hero's corner light, selected rows -->
  <SolidColorBrush x:Key="Focus"    Color="#FFFFFF"/> <!-- Keyboard focus: the 2px outer ring -->
  <SolidColorBrush x:Key="FocusIn"  Color="#B3000000"/> <!-- Keyboard focus: the 1px inner ring -->
  <SolidColorBrush x:Key="Sub"      Color="#0FFFFFFF"/> <!-- Subtle buttons, nav items, menu rows on hover; the selected nav item -->
  <SolidColorBrush x:Key="SubP"     Color="#0AFFFFFF"/> <!-- Subtle buttons and nav items pressed -->
  <SolidColorBrush x:Key="Ctl"      Color="#0FFFFFFF"/> <!-- Button, combobox, text box at rest; toggle track off -->
  <SolidColorBrush x:Key="CtlH"     Color="#15FFFFFF"/> <!-- Controls and clickable cards on hover -->
  <SolidColorBrush x:Key="CtlP"     Color="#08FFFFFF"/> <!-- Controls pressed -->
  <SolidColorBrush x:Key="CtlBd"    Color="#12FFFFFF"/> <!-- Control stroke (top and sides) -->
  <SolidColorBrush x:Key="CtlBd2"   Color="#18FFFFFF"/> <!-- Control stroke, bottom edge -->
  <SolidColorBrush x:Key="Line"     Color="#8BFFFFFF"/> <!-- Strong strokes: off toggle, unchecked box and radio, text box underline -->
  <SolidColorBrush x:Key="InFocus"  Color="#B31E1E1E"/> <!-- Text box fill with keyboard focus -->
  <SolidColorBrush x:Key="Warn"     Color="#FCE100"/> <!-- Caution: the risk badge and InfoBar icon -->
  <SolidColorBrush x:Key="WarnSoft" Color="#433519"/> <!-- Caution InfoBar and badge background -->
  <SolidColorBrush x:Key="WarnT"    Color="#000000"/> <!-- Text on a solid Warn badge (Advanced) -->
  <SolidColorBrush x:Key="Bad"      Color="#FF99A4"/> <!-- Critical: failed Outcomes, errors -->
  <SolidColorBrush x:Key="BadSoft"  Color="#442726"/> <!-- Error InfoBar background -->
  <SolidColorBrush x:Key="Ok"       Color="#6CCB5F"/> <!-- Success: Applied Outcomes, the success InfoBar icon -->
  <SolidColorBrush x:Key="OkSoft"   Color="#393D1B"/> <!-- Success InfoBar background -->
  <SolidColorBrush x:Key="Info"     Color="#FFA3AE"/> <!-- Informational InfoBar icon (= AccText) -->
  <SolidColorBrush x:Key="InfoSoft" Color="#08FFFFFF"/> <!-- Informational InfoBar background -->
  <SolidColorBrush x:Key="Tip"      Color="#2C2C2C"/> <!-- Tooltip fill -->
  <SolidColorBrush x:Key="TipBd"    Color="#33000000"/> <!-- Tooltip stroke -->
  <SolidColorBrush x:Key="TipT"     Color="#FFFFFF"/> <!-- Tooltip text -->
  <SolidColorBrush x:Key="Track"    Color="#8BFFFFFF"/> <!-- Progress bar track (1px) under the 3px Acc bar -->
  <SolidColorBrush x:Key="Scrim"    Color="#4D000000"/> <!-- Dims the window under a dialog -->
  <SolidColorBrush x:Key="CloseH"   Color="#C42B1C"/> <!-- Title bar close on hover -->
  <SolidColorBrush x:Key="CloseP"   Color="#C83C30"/> <!-- Title bar close pressed -->
  <SolidColorBrush x:Key="CloseT"   Color="#FFFFFF"/> <!-- The close glyph on CloseH / CloseP -->
  <Color x:Key="Shade">#2E000000</Color> <!-- Tile hover shadow, rgba(0,0,0,.18) -->
  <Color x:Key="ShadeFly">#42000000</Color> <!-- Flyout and toast shadow, rgba(0,0,0,.26 / .14) -->
  <Color x:Key="ShadeDlg">#5E000000</Color> <!-- Dialog shadow, rgba(0,0,0,.37 / .19) -->
</ResourceDictionary>
