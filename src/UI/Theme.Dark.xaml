<!-- AkariOS dark theme: every brush the UI uses, swapped as a whole by Set-AkariTheme (UI\Shell.ps1).
     Windows 11's (WinUI 3) colours, plan docs/plans/2026-11-17-windows-11-style.md (ADR 0008); keep Theme.Dark.xaml and
     Theme.Light.xaml on the same keys. Acc, AccH, AccP, AccT, AccText, AccSoft and Info are the default-blue fallbacks:
     Set-AkariAccent puts the user's Windows accent in their place. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg"       Color="#202020"/> <!-- window body without Mica (Windows 10), the dialog's button strip -->
  <SolidColorBrush x:Key="Tint"     Color="#D9202020"/> <!-- window body over Mica: Bg at 85% -->
  <SolidColorBrush x:Key="Surf"     Color="#4D3A3A3A"/> <!-- the content layer right of the navigation pane -->
  <SolidColorBrush x:Key="S1"       Color="#0DFFFFFF"/> <!-- settings cards, expanders, tiles -->
  <SolidColorBrush x:Key="S1Alt"    Color="#08FFFFFF"/> <!-- nested rows inside an expanded settings expander -->
  <SolidColorBrush x:Key="S2"       Color="#2C2C2C"/> <!-- flyouts, menus, drop-downs, dialogs -->
  <SolidColorBrush x:Key="Bd"       Color="#1A000000"/> <!-- 1 px card stroke -->
  <SolidColorBrush x:Key="Div"      Color="#15FFFFFF"/> <!-- dividers between rows, the content layer's edge -->
  <SolidColorBrush x:Key="Fly"      Color="#66757575"/> <!-- 1 px stroke of flyouts, menus, dialogs -->
  <SolidColorBrush x:Key="Tx"       Color="#FFFFFF"/> <!-- primary text and icons -->
  <SolidColorBrush x:Key="Mu"       Color="#C8FFFFFF"/> <!-- secondary text: descriptions, the status line, icons in rows -->
  <SolidColorBrush x:Key="Ter"      Color="#8BFFFFFF"/> <!-- tertiary text (12 px+): ids, versions, placeholders -->
  <SolidColorBrush x:Key="TxDis"    Color="#5DFFFFFF"/> <!-- disabled text and icons -->
  <SolidColorBrush x:Key="Acc"      Color="#4CC2FF"/> <!-- accent fill: primary buttons, on toggles, checks, selection, progress (AccentLight2) -->
  <SolidColorBrush x:Key="AccH"     Color="#E64CC2FF"/> <!-- accent on hover (90%) -->
  <SolidColorBrush x:Key="AccP"     Color="#CC4CC2FF"/> <!-- accent pressed (80%) -->
  <SolidColorBrush x:Key="AccT"     Color="#000000"/> <!-- text and glyphs on Acc / AccH / AccP -->
  <SolidColorBrush x:Key="AccText"  Color="#99EBFF"/> <!-- accent as text: links, the selected nav icon (AccentLight3) -->
  <SolidColorBrush x:Key="AccSoft"  Color="#1A4CC2FF"/> <!-- selected rows, icon tiles: the accent at 10% -->
  <SolidColorBrush x:Key="Focus"    Color="#FFFFFF"/> <!-- keyboard focus: the 2 px outer ring -->
  <SolidColorBrush x:Key="FocusIn"  Color="#B3000000"/> <!-- keyboard focus: the 1 px inner ring -->
  <SolidColorBrush x:Key="Sub"      Color="#0FFFFFFF"/> <!-- subtle buttons, nav items, menu rows on hover; the selected nav item -->
  <SolidColorBrush x:Key="SubP"     Color="#0AFFFFFF"/> <!-- subtle buttons and nav items pressed -->
  <SolidColorBrush x:Key="Ctl"      Color="#0FFFFFFF"/> <!-- control fill at rest; toggle track when off -->
  <SolidColorBrush x:Key="CtlH"     Color="#15FFFFFF"/> <!-- control fill on hover -->
  <SolidColorBrush x:Key="CtlP"     Color="#08FFFFFF"/> <!-- control fill pressed -->
  <SolidColorBrush x:Key="CtlBd"    Color="#12FFFFFF"/> <!-- control stroke (top and sides) -->
  <SolidColorBrush x:Key="CtlBd2"   Color="#18FFFFFF"/> <!-- control stroke, bottom edge -->
  <SolidColorBrush x:Key="Line"     Color="#8BFFFFFF"/> <!-- strong strokes: off toggle, unchecked boxes, text box underline -->
  <SolidColorBrush x:Key="InFocus"  Color="#B31E1E1E"/> <!-- text box fill with keyboard focus -->
  <SolidColorBrush x:Key="Warn"     Color="#FCE100"/> <!-- caution: the risk badge, the InfoBar icon -->
  <SolidColorBrush x:Key="WarnSoft" Color="#433519"/> <!-- caution InfoBar and badge background -->
  <SolidColorBrush x:Key="WarnT"    Color="#000000"/> <!-- text on solid Warn -->
  <SolidColorBrush x:Key="Bad"      Color="#FF99A4"/> <!-- critical: failed Outcomes, errors -->
  <SolidColorBrush x:Key="BadSoft"  Color="#442726"/> <!-- error InfoBar background -->
  <SolidColorBrush x:Key="Ok"       Color="#6CCB5F"/> <!-- success: Applied Outcomes, the ready dot -->
  <SolidColorBrush x:Key="OkSoft"   Color="#393D1B"/> <!-- success InfoBar background -->
  <SolidColorBrush x:Key="Info"     Color="#99EBFF"/> <!-- informational InfoBar icon (follows AccText) -->
  <SolidColorBrush x:Key="InfoSoft" Color="#08FFFFFF"/> <!-- informational InfoBar background -->
  <SolidColorBrush x:Key="Tip"      Color="#2C2C2C"/> <!-- tooltip fill -->
  <SolidColorBrush x:Key="TipBd"    Color="#33000000"/> <!-- tooltip stroke -->
  <SolidColorBrush x:Key="TipT"     Color="#FFFFFF"/> <!-- tooltip text -->
  <SolidColorBrush x:Key="Track"    Color="#8BFFFFFF"/> <!-- progress track (1 px) under the 3 px Acc bar -->
  <SolidColorBrush x:Key="Scrim"    Color="#4D000000"/> <!-- dims the window under a dialog -->
  <SolidColorBrush x:Key="CloseH"   Color="#C42B1C"/> <!-- title bar close on hover -->
  <SolidColorBrush x:Key="CloseP"   Color="#C83C30"/> <!-- title bar close pressed -->
  <SolidColorBrush x:Key="CloseT"   Color="#FFFFFF"/> <!-- close glyph on CloseH / CloseP -->
</ResourceDictionary>
