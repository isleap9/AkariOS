<!-- AkariOS light theme: every brush the UI uses, swapped as a whole by Set-AkariTheme (UI\Shell.ps1).
     WinUI 3 values (plan docs/plans/2026-11-19-winui-3.md, prototype docs/design/akarios-prototype.html).
     Acc* are Akari crimson; Set-AkariAccent replaces them when Settings follows the Windows accent.
     Keep Theme.Dark.xaml and Theme.Light.xaml on the same keys. Shade* are Colors (DropShadowEffect). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Bg"       Color="#F3F3F3"/> <!-- Window background without Mica (Windows 10), the dialog's button strip, the Guided footer -->
  <SolidColorBrush x:Key="Tint"     Color="#D9F3F3F3"/> <!-- Window body over Mica on Windows 11: Bg at 85% -->
  <SolidColorBrush x:Key="Surf"     Color="#80FFFFFF"/> <!-- The content layer right of the navigation pane -->
  <SolidColorBrush x:Key="S1"       Color="#B3FFFFFF"/> <!-- Settings cards, expanders, tiles -->
  <SolidColorBrush x:Key="S1Alt"    Color="#80F6F6F6"/> <!-- Nested rows inside an expander; a card while pressed -->
  <SolidColorBrush x:Key="S2"       Color="#F9F9F9"/> <!-- Flyouts, menus, drop-downs, dialogs, toasts -->
  <SolidColorBrush x:Key="Bd"       Color="#0F000000"/> <!-- 1px card stroke -->
  <SolidColorBrush x:Key="Div"      Color="#0F000000"/> <!-- Dividers between rows, the content layer's edge, the dialog footer rule -->
  <SolidColorBrush x:Key="Fly"      Color="#0F000000"/> <!-- 1px stroke of flyouts, menus, dialogs and toasts -->
  <SolidColorBrush x:Key="Tx"       Color="#E4000000"/> <!-- Primary text and icons -->
  <SolidColorBrush x:Key="Mu"       Color="#9E000000"/> <!-- Secondary text: descriptions, icons in rows -->
  <SolidColorBrush x:Key="Ter"      Color="#8F000000"/> <!-- Tertiary text (12px+): ids, versions, placeholders -->
  <SolidColorBrush x:Key="TxDis"    Color="#5C000000"/> <!-- Disabled text and icons -->
  <SolidColorBrush x:Key="Acc"      Color="#C8102E"/> <!-- Accent fill (Akari crimson): accent buttons, on toggles, checks, radios, the nav indicator, progress -->
  <SolidColorBrush x:Key="AccH"     Color="#E6C8102E"/> <!-- Accent fill on hover (90%) -->
  <SolidColorBrush x:Key="AccP"     Color="#CCC8102E"/> <!-- Accent fill pressed (80%) -->
  <SolidColorBrush x:Key="AccT"     Color="#FFFFFF"/> <!-- Text and glyphs on the accent fill -->
  <SolidColorBrush x:Key="AccBd"    Color="#14FFFFFF"/> <!-- Accent button stroke (top and sides) -->
  <SolidColorBrush x:Key="AccBd2"   Color="#66000000"/> <!-- Accent button stroke, bottom edge -->
  <SolidColorBrush x:Key="AccText"  Color="#9E0C24"/> <!-- Accent as text: links, tile footers, the selected nav icon -->
  <SolidColorBrush x:Key="AccSoft"  Color="#14C8102E"/> <!-- Accent tint: tile icon squares, the hero's corner light, selected rows -->
  <SolidColorBrush x:Key="Focus"    Color="#E4000000"/> <!-- Keyboard focus: the 2px outer ring -->
  <SolidColorBrush x:Key="FocusIn"  Color="#B3FFFFFF"/> <!-- Keyboard focus: the 1px inner ring -->
  <SolidColorBrush x:Key="Sub"      Color="#09000000"/> <!-- Subtle buttons, nav items, menu rows on hover; the selected nav item -->
  <SolidColorBrush x:Key="SubP"     Color="#06000000"/> <!-- Subtle buttons and nav items pressed -->
  <SolidColorBrush x:Key="Ctl"      Color="#B3FFFFFF"/> <!-- Button, combobox, text box at rest; toggle track off -->
  <SolidColorBrush x:Key="CtlH"     Color="#80F9F9F9"/> <!-- Controls and clickable cards on hover -->
  <SolidColorBrush x:Key="CtlP"     Color="#4DF9F9F9"/> <!-- Controls pressed -->
  <SolidColorBrush x:Key="CtlBd"    Color="#0F000000"/> <!-- Control stroke (top and sides) -->
  <SolidColorBrush x:Key="CtlBd2"   Color="#29000000"/> <!-- Control stroke, bottom edge -->
  <SolidColorBrush x:Key="Line"     Color="#72000000"/> <!-- Strong strokes: off toggle, unchecked box and radio, text box underline -->
  <SolidColorBrush x:Key="InFocus"  Color="#FFFFFF"/> <!-- Text box fill with keyboard focus -->
  <SolidColorBrush x:Key="Warn"     Color="#9D5D00"/> <!-- Caution: the risk badge and InfoBar icon -->
  <SolidColorBrush x:Key="WarnSoft" Color="#FFF4CE"/> <!-- Caution InfoBar and badge background -->
  <SolidColorBrush x:Key="WarnT"    Color="#FFFFFF"/> <!-- Text on a solid Warn badge (Advanced) -->
  <SolidColorBrush x:Key="Bad"      Color="#C42B1C"/> <!-- Critical: failed Outcomes, errors -->
  <SolidColorBrush x:Key="BadSoft"  Color="#FDE7E9"/> <!-- Error InfoBar background -->
  <SolidColorBrush x:Key="Ok"       Color="#0F7B0F"/> <!-- Success: Applied Outcomes, the success InfoBar icon -->
  <SolidColorBrush x:Key="OkSoft"   Color="#DFF6DD"/> <!-- Success InfoBar background -->
  <SolidColorBrush x:Key="Info"     Color="#9E0C24"/> <!-- Informational InfoBar icon (= AccText) -->
  <SolidColorBrush x:Key="InfoSoft" Color="#80F6F6F6"/> <!-- Informational InfoBar background -->
  <SolidColorBrush x:Key="Tip"      Color="#F9F9F9"/> <!-- Tooltip fill -->
  <SolidColorBrush x:Key="TipBd"    Color="#0F000000"/> <!-- Tooltip stroke -->
  <SolidColorBrush x:Key="TipT"     Color="#E4000000"/> <!-- Tooltip text -->
  <SolidColorBrush x:Key="Track"    Color="#72000000"/> <!-- Progress bar track (1px) under the 3px Acc bar -->
  <SolidColorBrush x:Key="Scrim"    Color="#4D000000"/> <!-- Dims the window under a dialog -->
  <SolidColorBrush x:Key="CloseH"   Color="#C42B1C"/> <!-- Title bar close on hover -->
  <SolidColorBrush x:Key="CloseP"   Color="#C83C30"/> <!-- Title bar close pressed -->
  <SolidColorBrush x:Key="CloseT"   Color="#FFFFFF"/> <!-- The close glyph on CloseH / CloseP -->
  <Color x:Key="Shade">#2E000000</Color> <!-- Tile hover shadow, rgba(0,0,0,.18) -->
  <Color x:Key="ShadeFly">#24000000</Color> <!-- Flyout and toast shadow, rgba(0,0,0,.26 / .14) -->
  <Color x:Key="ShadeDlg">#30000000</Color> <!-- Dialog shadow, rgba(0,0,0,.37 / .19) -->
</ResourceDictionary>
