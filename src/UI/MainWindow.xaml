<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AkariOS" Width="1100" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontText}" FontSize="14" FontWeight="Medium"
        Background="Transparent" Foreground="{DynamicResource Tx}">
  <!-- The shell (the design system's): a 64 px top bar (the A mark and wordmark, pill tabs, search, the options
       menu and caption buttons), a page header (icon, Unbounded title, subtitle), Optimize's sub-header (Sections and
       Category chips), the page on one rounded surface, and a status bar. The frame is extended over the whole window
       (GlassFrameThickness -1) so Windows draws Mica behind it; the window draws its own min / max / close buttons. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" GlassFrameThickness="-1" ResizeBorderThickness="6"
                  UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Brushes come from UI\Theme.Dark.xaml or UI\Theme.Light.xaml, merged in by Set-AkariTheme (UI\Shell.ps1):
         every colour here is a DynamicResource so a theme switch repaints the window. -->
    <!-- a Lucide icon (UI\Icons.xaml, Ic.<name>) in a 24x24 Canvas inside a Viewbox: stroke 2, round caps and joins,
         the colour of the button or control it sits in (the caption buttons' hover colours carry over) -->
    <Style x:Key="Ic" TargetType="Path">
      <Setter Property="StrokeThickness" Value="2"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>

    <!-- Keyboard focus: a 2 px Focus ring 3 px outside the control. FocusRing for pills (buttons, switches, text
         boxes, combos), FocusBox for square things (check boxes, cards). Every focusable control uses one. -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="21" RadiusY="21" Stroke="{DynamicResource Focus}" StrokeThickness="2" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FocusBox">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="{DynamicResource Focus}" StrokeThickness="2" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary button: a pill with a control fill and a 1 px stroke, SemiBold text. -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="{DynamicResource Ctl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
      <Setter Property="Padding" Value="16,7,16,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Primary button: the crimson pill (Acc, AccT text) with the lamp glow under it; AccH on hover, AccP pressed. -->
    <Style x:Key="BtnP" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Acc}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccT}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Acc}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect x:Name="Glow" Color="{DynamicResource AccC}" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.35"/>
              </Border.Effect>
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccH}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccH}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccP}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AccP}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
                <Setter TargetName="B" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Ghost button: no fill until hover (the pane toggle, icon buttons), round. -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="18">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Ctl}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Menus (the title bar menu, Quick select): a dark rounded panel with a shadow, rows with an icon column,
         after Win11Debloat's options menu. -->
    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="HorizontalOffset" Value="-12"/>
      <Setter Property="VerticalOffset" Value="-8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <!-- the outer margin leaves room for the shadow inside the popup -->
            <Border Margin="12">
              <Border Background="{DynamicResource S2}" BorderBrush="{DynamicResource Bd}" BorderThickness="1"
                      CornerRadius="12" Padding="6" MinWidth="200">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" Opacity="0.4" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,0,16,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="10,0,0,1"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Margin" Value="4,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource Bd}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title bar caption button (46 x 32, clickable inside the drag region). -->
    <Style x:Key="Cap" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Ctl}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CapX" TargetType="Button" BasedOn="{StaticResource Cap}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CloseH}"/>
                <Setter Property="Foreground" Value="{DynamicResource CloseT}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CloseP}"/>
                <Setter Property="Foreground" Value="{DynamicResource CloseT}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Top bar tab (Home, Install, Optimize, Downloads, USB): a pill with an icon and a label (built in UI\Shell.ps1),
         crimson tint and crimson text when it is the current one. Clickable inside the title bar's drag region. -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="18" Background="Transparent" Padding="14,7,14,8">
              <ContentPresenter x:Name="C" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
                <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccText}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Category chip (Optimize's sub-header, under the Section row): a small outlined pill, crimson when current. -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="B" CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource CtlBd}" Background="{DynamicResource Ctl}"
                    Padding="10,4,12,5">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Acc}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccT}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text box: a pill (a multi-line box: 12 px corners), control fill and stroke; with keyboard focus the stroke
         turns crimson inside a soft crimson halo (the focus ring of text boxes). -->
    <Style x:Key="Flat" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="{DynamicResource Ctl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Tx}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Acc}"/>
      <Setter Property="Padding" Value="14,7,14,8"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="Halo" Margin="-3" CornerRadius="21" BorderThickness="3" BorderBrush="{DynamicResource AccSoft}" Visibility="Collapsed"/>
              <!-- no Padding here: the TextBox pads its own text host with its Padding -->
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="18">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="AcceptsReturn" Value="True">
                <Setter TargetName="B" Property="CornerRadius" Value="12"/>
                <Setter TargetName="Halo" Property="CornerRadius" Value="15"/>
                <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource InFocus}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Acc}"/>
                <Setter TargetName="Halo" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin rounded scrollbar thumb, as WinUI's at rest. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" Background="{DynamicResource Line}" CornerRadius="3" Width="6" Margin="0,4" Opacity="0.6"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="T" Property="Width" Value="8"/>
                          <Setter TargetName="T" Property="CornerRadius" Value="4"/>
                          <Setter TargetName="T" Property="Opacity" Value="1"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource TipT}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <!-- inverted: paper on black in dark, ink on paper in light -->
            <Border Background="{DynamicResource Tip}" BorderBrush="{DynamicResource TipBd}" BorderThickness="1" CornerRadius="8" Padding="10,6,10,7">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Akari black behind the whole window: solid without Mica (Windows 10), a near-black tint over
         Mica when it is on (set in code). -->
    <Border x:Name="Body" Grid.RowSpan="3" Background="{DynamicResource Bg}"/>

    <!-- Top bar (the window's drag region; the tabs, search and buttons stay clickable): the A mark and wordmark, the
         tabs (UI\Shell.ps1), then the search, the options menu and the caption buttons on the right. The tabs take
         the space left (clipped if it runs out): the search and the caption buttons always keep theirs. -->
    <Grid x:Name="TopBar">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,24,0">
        <!-- the A mark for the theme (Update-AkariLogo, UI\Shell.ps1) -->
        <Image x:Name="Logo" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="TitleText" Text="AkariOS" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True"/>
      <!-- search: a pill box, or in a narrow window an icon button that opens it (Ctrl+K at any width) -->
      <Grid x:Name="SearchBox" Grid.Column="2" Width="260" VerticalAlignment="Center" Margin="12,0,8,0"
            WindowChrome.IsHitTestVisibleInChrome="True">
        <TextBox x:Name="Search" Style="{StaticResource Flat}" Padding="38,7,14,8"/>
        <TextBlock x:Name="SearchHint" Text="Search" Foreground="{DynamicResource Mu}" Margin="40,0,0,1"
                   VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,1" IsHitTestVisible="False">
          <Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Mu}" Data="{DynamicResource Ic.search}"/></Canvas>
        </Viewbox>
      </Grid>
      <Button x:Name="SearchBtn" Grid.Column="2" Style="{StaticResource Ghost}" Width="36" Height="36" Margin="12,0,8,0"
              VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Search (Ctrl+K)" WindowChrome.IsHitTestVisibleInChrome="True">
        <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Data="{DynamicResource Ic.search}"/></Canvas></Viewbox>
      </Button>

    <!-- Caption buttons, drawn like Windows 11's: the options menu (UI\About.ps1), minimize, maximize / restore,
         close (red on hover). -->
    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="MenuBtn" Style="{StaticResource Cap}" ToolTip="Options">
        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Data="{DynamicResource Ic.menu}"/></Canvas></Viewbox>
      </Button>
      <Button x:Name="CapMin" Style="{StaticResource Cap}" ToolTip="Minimize">
        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Data="{DynamicResource Ic.minus}"/></Canvas></Viewbox>
      </Button>
      <Button x:Name="CapMax" Style="{StaticResource Cap}" ToolTip="Maximize">
        <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path x:Name="CapMaxGlyph" Style="{StaticResource Ic}" Data="{DynamicResource Ic.square}"/></Canvas></Viewbox>
      </Button>
      <Button x:Name="CapClose" Style="{StaticResource CapX}" ToolTip="Close">
        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Data="{DynamicResource Ic.x}"/></Canvas></Viewbox>
      </Button>
    </StackPanel>
    </Grid>

    <!-- Main -->
    <Grid x:Name="Main" Grid.Row="1" Margin="20,8,20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Page header: icon, title, subtitle (hidden on Home). -->
      <Grid x:Name="PageHeader" Margin="4,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Viewbox Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,16,0">
          <Canvas Width="24" Height="24">
            <Path x:Name="HeaderIcon" Style="{StaticResource Ic}" Stroke="{DynamicResource Acc}"/>
          </Canvas>
        </Viewbox>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Heading" FontFamily="{DynamicResource FontDisplay}" FontSize="32" FontWeight="Bold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="HeaderSub" Foreground="{DynamicResource Mu}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <!-- Optimize's sub-header (UI\Shell.ps1): the Sections as a segmented row (Legacy last), the Section's Categories
           as chips under it, and Remove apps on the right. Only on Optimize's pages. -->
      <DockPanel x:Name="SubNav" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
        <Button x:Name="RemoveApps" DockPanel.Dock="Right" Style="{StaticResource Btn}" VerticalAlignment="Top" Margin="12,0,0,0"
                ToolTip="Store apps, optional features, Windows features and legacy apps to remove">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Data="{DynamicResource Ic.trash-2}"/></Canvas></Viewbox>
            <TextBlock Text="Remove apps"/>
          </StackPanel>
        </Button>
        <StackPanel>
          <ListBox x:Name="Sections" Style="{DynamicResource Segmented}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
          <WrapPanel x:Name="Chips"/>
        </StackPanel>
      </DockPanel>

      <!-- The page's surface: one rounded, bordered panel. -->
      <Border Grid.Row="2" CornerRadius="20" BorderThickness="1"
              BorderBrush="{DynamicResource Bd}" Background="{DynamicResource Surf}">
        <DockPanel>
        <!-- Guided steps footer, pinned under the page (Win11Debloat-style): Back on the left, the step dots centred,
             Next / Review / Apply on the right. -->
        <Border x:Name="StepFooter" DockPanel.Dock="Bottom" Visibility="Collapsed" BorderBrush="{DynamicResource Bd}" BorderThickness="0,1,0,0">
          <Grid Margin="24,12">
            <Button x:Name="StepBack" Style="{StaticResource Btn}" Content="Back" HorizontalAlignment="Left" MinWidth="96"/>
            <StackPanel x:Name="StepDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="StepNext" Style="{DynamicResource Accent}" Content="Next" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
        <!-- Optimize › Advanced: the Safe Mode and restart bars, pinned under the page (UI\CataloguePage.ps1) -->
        <StackPanel x:Name="CatBars" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Page" Margin="24,20,24,20">

            <!-- Install AkariOS: the chooser, then the current Guided step (UI\Steps.ps1) -->
            <StackPanel x:Name="StepsPanel" Visibility="Collapsed">
              <StackPanel x:Name="StepBody"/>
            </StackPanel>

            <!-- Home page: the update bar (only when a newer release exists, UI\About.ps1), the hero (headline, lead,
                 One-click and Choose changes, three stats read in the background: UI\Shell.ps1) and the mode cards
                 (built in UI\Shell.ps1). Home has no page header: the hero is its title. -->
            <StackPanel x:Name="HomePanel" Visibility="Collapsed">
              <Border x:Name="UpdateBar" Visibility="Collapsed" CornerRadius="4" BorderThickness="1" Padding="16,10" Margin="0,0,0,12"
                      BorderBrush="{DynamicResource Bd}" Background="{DynamicResource S1}">
                <DockPanel>
                  <Viewbox DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource Ok}" Data="{DynamicResource Ic.download}"/></Canvas>
                  </Viewbox>
                  <Button x:Name="UpdateOpen" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="See what's new" Margin="12,0,0,0"/>
                  <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
              </Border>
              <StackPanel x:Name="Hero" Margin="8,12,8,36">
                <TextBlock x:Name="HeroOver" FontFamily="{DynamicResource FontDisplay}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccText}" Margin="0,0,0,12"/>
                <TextBlock Text="Windows, tuned for games." FontFamily="{DynamicResource FontDisplay}" FontSize="40" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock Foreground="{DynamicResource Mu}" FontSize="16" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" Margin="0,12,0,0"
                           Text="Remove the bloat, apply the tweaks that matter and keep a way back: every change can be reverted to the Windows default."/>
                <WrapPanel Margin="0,24,0,0">
                  <Button x:Name="HeroOneClick" Style="{StaticResource BtnP}" Margin="0,0,12,8" ToolTip="The full AkariOS setup in one go, with restarts handled for you">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="16" Height="16" Margin="0,0,8,0"><Canvas Width="24" Height="24"><Path Style="{StaticResource Ic}" Stroke="{DynamicResource AccT}" Data="{DynamicResource Ic.zap}"/></Canvas></Viewbox>
                      <TextBlock Text="One-click setup"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="HeroChoose" Style="{StaticResource Btn}" Content="Choose changes" Margin="0,0,0,8"
                          ToolTip="Pick the apps and Tweaks yourself, review them, then apply them in one go"/>
                </WrapPanel>
                <!-- the stats: Tweaks, removable apps, changes applied (a dash until read) -->
                <StackPanel x:Name="HeroStats" Orientation="Horizontal" Margin="0,28,0,0"/>
              </StackPanel>
              <TextBlock Text="MORE TOOLS" FontFamily="{DynamicResource FontDisplay}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource Mu}" Margin="8,0,0,12"/>
              <!-- columns follow the window's width (Update-AkariWidth) -->
              <UniformGrid x:Name="HomeTiles" Columns="4"/>
            </StackPanel>

            <StackPanel x:Name="Rows"/>
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>

    <!-- Status bar: Ready, or what is running now with a progress bar; the app name and version on the right. -->
    <Grid Grid.Row="2" Margin="24,8,20,8">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- the green dot at rest; a spinning ring while something runs -->
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource Ok}"/>
        <Path x:Name="StatusRing" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
              Data="M7,1 A6,6 0 1 1 1,7" Stroke="{DynamicResource Acc}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
          <Path.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                   From="0" To="360" Duration="0:0:1"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
        <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Mu}"
                   MaxWidth="520" TextTrimming="CharacterEllipsis"/>
        <!-- progress bar: StatusFill shows how far a Run is (Set-AkariProgress), the sliding StatusLoop while the job
             doesn't say (a single change, the restore point) -->
        <Border x:Name="StatusBar" Width="160" Height="4" Margin="12,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                Background="{DynamicResource Track}" ClipToBounds="True" Visibility="Collapsed">
          <Grid>
          <Rectangle x:Name="StatusFill" Width="0" HorizontalAlignment="Left" Fill="{DynamicResource Acc}" RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
          <Rectangle x:Name="StatusLoop" Width="56" HorizontalAlignment="Left" Fill="{DynamicResource Acc}" RadiusX="2" RadiusY="2">
            <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
            <Rectangle.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-56" To="160" Duration="0:0:1.4"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Rectangle.Triggers>
          </Rectangle>
          </Grid>
        </Border>
      </StackPanel>
      <Button x:Name="AppVersion" Style="{StaticResource Ghost}" HorizontalAlignment="Right" VerticalAlignment="Center"
              Cursor="Hand" ToolTip="About AkariOS: version, updates and credits">
        <TextBlock x:Name="AppVersionText" Margin="6,1" FontSize="12" FontFamily="{DynamicResource FontMono}" Text="AkariOS" Foreground="{DynamicResource Ter}"/>
      </Button>
    </Grid>

    <!-- Dims the whole window while an Akari dialog (UI\Dialog.ps1) is open. -->
    <Border x:Name="ModalOverlay" Grid.RowSpan="3" Background="{DynamicResource Scrim}" Visibility="Collapsed"/>
  </Grid>
</Window>
