<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AkariOS" Width="1180" Height="760" MinWidth="640" MinHeight="500"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontText}" FontSize="14" FontWeight="Normal"
        Background="Transparent" Foreground="{DynamicResource Tx}">
  <!-- The shell, a WinUI 3 window (plan docs/plans/2026-11-19-winui-3.md, the prototype docs/design/akarios-prototype.html):
       a 48 px title bar, a left NavigationView on Mica, the pages on the content layer, toasts at the bottom right, the
       dialog's smoke. The frame is extended over the whole window (GlassFrameThickness -1) so Windows draws Mica behind
       it; Windows draws the caption buttons (minimize, maximize, close) itself, in a hole Body leaves for them. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6"
                  UseAeroCaptionButtons="True" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Brushes come from UI\Theme.Dark.xaml or UI\Theme.Light.xaml, merged in by Set-AkariTheme (UI\Shell.ps1): every
         colour here is a DynamicResource so a theme switch repaints the window. Animations: UI\Motion.xaml's KeyTimes and
         KeySplines (Motion.Ease in, Motion.Exit out); hover / press fills are layers whose Opacity fades. -->
    <!-- a Fluent System Icon (UI\Icons.xaml, Ic.<name>): a filled 20 x 20 path, in the colour of the control it sits in -->
    <Style x:Key="Ic" TargetType="Path">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>

    <!-- Keyboard focus, Fluent's double ring: 2 px Focus outside (1 px off the control), 1 px FocusIn inside it.
         FocusRing for 4 px controls (buttons, combos, text boxes, cards), FocusBox for tiles and check boxes, FocusPill
         for toggles and radios. Every focusable control uses one. -->
    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Grid Margin="-3" SnapsToDevicePixels="True">
              <Border CornerRadius="7" BorderBrush="{DynamicResource Focus}" BorderThickness="2"/>
              <Border Margin="2" CornerRadius="5" BorderBrush="{DynamicResource FocusIn}" BorderThickness="1"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FocusBox">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Grid Margin="-3" SnapsToDevicePixels="True">
              <Border CornerRadius="11" BorderBrush="{DynamicResource Focus}" BorderThickness="2"/>
              <Border Margin="2" CornerRadius="9" BorderBrush="{DynamicResource FocusIn}" BorderThickness="1"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FocusPill">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Grid Margin="-3" SnapsToDevicePixels="True">
              <Border CornerRadius="13" BorderBrush="{DynamicResource Focus}" BorderThickness="2"/>
              <Border Margin="2" CornerRadius="11" BorderBrush="{DynamicResource FocusIn}" BorderThickness="1"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Standard button (.btn): 32 px, 4 px corners, 12 px side padding, Ctl fill, CtlBd stroke over a CtlBd2 bottom edge; CtlH on hover, CtlP and Mu text pressed. -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="{DynamicResource Ctl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0,12,1"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
              <Border x:Name="Bot" CornerRadius="0,0,4,4" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource CtlBd2}"/>
              <Border x:Name="H" CornerRadius="4" Margin="1" Background="{DynamicResource CtlH}" Opacity="0"/>
              <Border x:Name="P" CornerRadius="4" Margin="1" Background="{DynamicResource CtlP}" Opacity="0"/>
              <ContentPresenter x:Name="C" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Mu}"/><Setter TargetName="Bot" Property="Visibility" Value="Hidden"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Accent button, as the Accent style of Controls.xaml (parsed after this file): Acc fill, AccT text, 32 px, min 120 px; AccH on hover, AccP pressed. -->
    <Style x:Key="BtnP" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccT}"/>
      <Setter Property="Background" Value="{DynamicResource Acc}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="120"/>
      <Setter Property="Padding" Value="12,0,12,1"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource AccBd}" BorderThickness="1"/>
              <Border x:Name="H" CornerRadius="4" Background="{DynamicResource AccH}" Opacity="0"/>
              <Border x:Name="P" CornerRadius="4" Background="{DynamicResource AccP}" Opacity="0"/>
              <Border CornerRadius="0,0,4,4" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AccBd2}"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Subtle button (.btn.sub, the title bar's Back and pane buttons, icon buttons): no fill until hover (Sub), SubP pressed. -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Padding" Value="12,0,12,1"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="H" CornerRadius="4" Background="{DynamicResource Sub}" Opacity="0"/>
              <Border x:Name="P" CornerRadius="4" Background="{DynamicResource SubP}" Opacity="0"/>
              <ContentPresenter x:Name="C" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Hyperlink button (.link): AccText, underlined on hover; its Content is the text. -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccText}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Background="Transparent"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Menus (Quick select, Save as preset): a flyout, S2 with a Fly stroke and 8 px corners, dropping 12 px and growing
         from 94 % over Motion.Slow (the prototype's .flyout); rows 32 px, Sub on hover. -->
    <Style TargetType="ContextMenu">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="HorizontalOffset" Value="-16"/>
      <Setter Property="VerticalOffset" Value="-8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border x:Name="M" Margin="16,12,16,24" RenderTransformOrigin="0.5,0">
              <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
              <Border Background="{DynamicResource S2}" BorderBrush="{DynamicResource Fly}" BorderThickness="1" CornerRadius="8" Padding="0,2" MinWidth="200">
                <Border.Effect><DropShadowEffect Color="{DynamicResource ShadeFly}" BlurRadius="16" ShadowDepth="8" Direction="270" Opacity="1"/></Border.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsOpen" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="M" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="M" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.94"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="M" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-12"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="M" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Slow.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="M" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Slow.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="M" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Slow.T}" KeySpline="{StaticResource Motion.Ease}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="M" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid Background="{TemplateBinding Background}" Margin="4,2">
              <Border x:Name="H" CornerRadius="4" Background="{DynamicResource Sub}" Opacity="0"/>
              <Border x:Name="P" CornerRadius="4" Background="{DynamicResource SubP}" Opacity="0"/>
              <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="0,6,0,7"/>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="P" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Div}"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text box (WinUI, .input): 32 px, 4 px corners, Ctl fill, CtlBd stroke, a 1 px Line bottom edge; CtlH on hover; with keyboard focus InFocus and a 2 px Acc bottom edge. -->
    <Style x:Key="Flat" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="{DynamicResource Ctl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Tx}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Acc}"/>
      <Setter Property="Padding" Value="10,5,10,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="B" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
              <Border x:Name="H" CornerRadius="4" Margin="1" Background="{DynamicResource CtlH}" Opacity="0"/>
              <Border x:Name="F" CornerRadius="4" Margin="1" Background="{DynamicResource InFocus}" Opacity="0"/>
              <Border x:Name="Under" Height="1" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource Line}"/>
              <Border x:Name="UnderOn" Height="2" VerticalAlignment="Bottom" CornerRadius="0,0,4,4" Background="{DynamicResource Acc}" Opacity="0"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="AcceptsReturn" Value="True"><Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="H" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="F" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="UnderOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="F" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="UnderOn" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Scroll bar (the prototype's: 12 px, a Line thumb 4 px wide that widens to 6 px over the bar) -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" Background="{DynamicResource Line}" CornerRadius="2" Width="4" Margin="0,4" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                      </Border>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                          <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="T" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Base.T}" KeySpline="{StaticResource Motion.Ease}" Value="1.5"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                          <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="T" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Base.T}" KeySpline="{StaticResource Motion.Exit}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tooltip (.tip): Tip fill, a TipBd stroke, 4 px corners, 12 px Caption text, a soft shadow; fades in over Motion.Base -->
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource TipT}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border x:Name="T" Margin="8,4,8,12" MaxWidth="296" Background="{DynamicResource Tip}" BorderBrush="{DynamicResource TipBd}" BorderThickness="1" CornerRadius="4" Padding="8,5,8,7">
              <Border.Effect><DropShadowEffect Color="{DynamicResource ShadeFly}" BlurRadius="8" ShadowDepth="4" Direction="270" Opacity="1"/></Border.Effect>
              <ContentPresenter TextBlock.FontFamily="{DynamicResource FontSmall}"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsOpen" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/></DoubleAnimationUsingKeyFrames><DoubleAnimationUsingKeyFrames Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Base.T}" KeySpline="{StaticResource Motion.Ease}" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="T" Storyboard.TargetProperty="Opacity"><SplineDoubleKeyFrame KeyTime="{StaticResource Motion.Fast.T}" KeySpline="{StaticResource Motion.Exit}" Value="0"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Mica behind the whole window on Windows 11 (Tint over it), the solid Bg on Windows 10 (Update-AkariFrame) -->
    <Border x:Name="Body" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Bg}"/>

    <!-- Title bar, 48 px (the window's drag region; its buttons stay clickable): Back (Alt+Left, disabled with no
         history), the pane toggle, the 16 px logo, "AkariOS" and the version in Caption; Windows' own caption buttons at the right. -->
    <Grid x:Name="TopBar" Grid.ColumnSpan="2">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="BackBtn" Style="{StaticResource Ghost}" Width="40" Height="36" Padding="0" Margin="4,0,0,0" IsEnabled="False"
                ToolTip="Back (Alt+Left)" Foreground="{DynamicResource Mu}" WindowChrome.IsHitTestVisibleInChrome="True">
          <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="{DynamicResource Ic.arrow-left}"/></Viewbox>
        </Button>
        <Button x:Name="PaneBtn" Style="{StaticResource Ghost}" Width="40" Height="36" Padding="0"
                ToolTip="Collapse navigation" Foreground="{DynamicResource Mu}" WindowChrome.IsHitTestVisibleInChrome="True">
          <Viewbox Width="16" Height="16"><Path Style="{StaticResource Ic}" Data="{DynamicResource Ic.menu}"/></Viewbox>
        </Button>
        <!-- the logo for the theme (Update-AkariLogo, UI\Shell.ps1) -->
        <Image x:Name="Logo" Width="16" Height="16" Margin="6,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="TitleText" Text="AkariOS" FontFamily="{DynamicResource FontSmall}" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock x:Name="AppVersionText" Margin="8,0,0,0" FontFamily="{DynamicResource FontSmall}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Ter}"/>
      </StackPanel>
    </Grid>

    <!-- NavigationView (the prototype's .nav): 280 px on Mica, 48 px collapsed (the pane toggle, or a window under
         1000 px). The search box, the pages (Optimize's sections indented under it, in NavKids), then a divider and
         Settings at the bottom. NavPill: the 3 x 16 Acc indicator, which stretches and slides to the selected item
         (Move-AkariNavPill, UI\Shell.ps1). The pane's width is one of ADR 0008's three animated sizes. -->
    <Grid x:Name="Nav" Grid.Row="1" Width="280" ClipToBounds="True">
      <DockPanel Margin="0,0,0,8">
        <Grid x:Name="SearchBox" DockPanel.Dock="Top" Margin="16,0,16,8">
          <TextBox x:Name="Search" Style="{StaticResource Flat}" Padding="10,5,58,6"/>
          <TextBlock x:Name="SearchHint" Text="Search Tweaks" Foreground="{DynamicResource Ter}" Margin="12,0,0,1"
                     VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Border x:Name="SearchKey" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0" Padding="5,1" CornerRadius="4"
                  BorderBrush="{DynamicResource CtlBd2}" BorderThickness="1" IsHitTestVisible="False">
            <TextBlock Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Ter}"/>
          </Border>
          <Viewbox Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False">
            <Path Width="20" Height="20" Fill="{DynamicResource Mu}" Data="{DynamicResource Ic.search}"/>
          </Viewbox>
        </Grid>
        <StackPanel x:Name="NavFoot" DockPanel.Dock="Bottom">
          <Border Height="1" Margin="0,4" Background="{DynamicResource Div}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavList"/>
        </ScrollViewer>
      </DockPanel>
      <Canvas x:Name="NavLayer" IsHitTestVisible="False">
        <Border x:Name="NavPill" Width="3" Height="16" Canvas.Left="4" CornerRadius="1.5" Background="{DynamicResource Acc}" Visibility="Hidden" RenderTransformOrigin="0.5,0">
          <Border.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Border.RenderTransform>
        </Border>
      </Canvas>
    </Grid>

    <!-- The content layer (.layer): Surf, a 1 px Div top and left edge, an 8 px top-left corner. The page is at most
         1064 px wide, 28 px from the top and 36 px from the sides. -->
    <Border x:Name="Layer" Grid.Row="1" Grid.Column="1" Background="{DynamicResource Surf}" BorderBrush="{DynamicResource Div}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
      <Grid>
        <!-- PageScroll glides on the wheel (Enable-AkariSmoothScroll) and goes back to the top on a new page -->
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <!-- the page fills the layer up to 1064 px (its 36 px sides included), centred in a wider window as the
               native app's (Views\PageLayout.cs): MaxWidth 992 + the margins, Stretch centres it past that -->
          <Grid>
          <StackPanel x:Name="Page" Margin="36,28,36,120" MaxWidth="992">
            <!-- the page title, or a breadcrumb whose earlier parts are links (Set-AkariHeader) -->
            <StackPanel x:Name="PageHeader" Margin="0,0,0,20">
              <StackPanel x:Name="Crumbs" Orientation="Horizontal" Margin="0,0,0,4" Visibility="Collapsed"/>
              <TextBlock x:Name="Heading" FontFamily="{DynamicResource FontDisplay}" FontSize="28" LineHeight="36" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <!-- InfoBars at the top of a page: restart required, changes waiting for Safe Mode (UI\CataloguePage.ps1) -->
            <StackPanel x:Name="CatBars"/>
            <!-- Install AkariOS, its flows, Settings, Install USB, the ISO Builder and Optimize: built into StepBody -->
            <StackPanel x:Name="StepsPanel" Visibility="Collapsed">
              <StackPanel x:Name="StepBody"/>
            </StackPanel>
            <!-- Home (UI\Home.ps1) -->
            <StackPanel x:Name="HomePanel" Visibility="Collapsed"/>
            <StackPanel x:Name="Rows"/>
          </StackPanel>
          </Grid>
        </ScrollViewer>
        <!-- Guided's footer (.foot): slides up from the bottom; "Step n of 3 . Name", a progress bar, Cancel / Back and
             the accent Next ("Apply n changes" on the last step) -->
        <Border x:Name="StepFooter" VerticalAlignment="Bottom" Visibility="Collapsed" Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Div}" BorderThickness="0,1,0,0" Padding="36,16">
          <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="StepBack" Style="{StaticResource Btn}" Content="Back" Margin="0,0,8,0"/>
              <Button x:Name="StepNext" Style="{StaticResource BtnP}" Content="Next"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="StepLabel" FontFamily="{DynamicResource FontSmall}" FontSize="12" Foreground="{DynamicResource Mu}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Grid x:Name="StepBar" Width="160" Height="3" VerticalAlignment="Center">
                <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Track}"/>
                <Rectangle x:Name="StepFill" RenderTransformOrigin="0,0.5" Fill="{DynamicResource Acc}" RadiusX="1.5" RadiusY="1.5"/>
              </Grid>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Toasts (.toast): at the bottom right, stacking upwards; a Run's is sticky, with an indeterminate bar
         (BusyToast: the job's label in StatusText, its progress in StatusFill, else the sliding StatusLoop) -->
    <StackPanel x:Name="Toasts" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,12">
      <Border x:Name="BusyToast" Width="340" Margin="0,8,0,0" Padding="16,14" Background="{DynamicResource S2}" BorderBrush="{DynamicResource Fly}"
              BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
        <Border.Effect><DropShadowEffect Color="{DynamicResource ShadeFly}" BlurRadius="16" ShadowDepth="8" Direction="270" Opacity="1"/></Border.Effect>
        <DockPanel>
          <Image x:Name="BusyLogo" DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Top" Margin="0,0,12,0"/>
          <StackPanel>
            <TextBlock x:Name="StatusText" Text="Working" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <Grid x:Name="StatusBar" Height="3" Margin="0,10,0,0" ClipToBounds="True">
              <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Track}"/>
              <Rectangle x:Name="StatusFill" RenderTransformOrigin="0,0.5" Fill="{DynamicResource Acc}" RadiusX="1.5" RadiusY="1.5" Visibility="Collapsed"/>
              <Rectangle x:Name="StatusLoop" Width="100" HorizontalAlignment="Left" Fill="{DynamicResource Acc}" RadiusX="1.5" RadiusY="1.5">
                <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
                <Rectangle.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <!-- .bar.indet: 35 % of the bar from -35 % to 100 %, 1.6 s, cubic-bezier(.55,.55,0,1), forever -->
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" Duration="0:0:1.6">
                          <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-100"/>
                          <SplineDoubleKeyFrame KeyTime="0:0:1.6" KeySpline="{StaticResource Motion.Exit}" Value="306"/>
                        </DoubleAnimationUsingKeyFrames>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Rectangle.Triggers>
              </Rectangle>
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>

    <!-- The dialog's smoke (ContentDialog, UI\Dialog.ps1): 30 % black over the whole window -->
    <Border x:Name="ModalOverlay" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Scrim}" Visibility="Collapsed"/>
  </Grid>
</Window>
