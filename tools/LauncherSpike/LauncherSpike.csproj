<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 0 launcher spike: prove the unelevated AkariOS process can launch the unmodified
    AME CLI elevated (single UAC via runas) with the extracted AkariOS V5 playbook.
    Throwaway tool; the real implementation will live in AkariOS.App.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LauncherSpike</AssemblyName>
  </PropertyGroup>

</Project>
