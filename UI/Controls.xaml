<!-- WinUI 3 style controls for the Manual steps, after Windows 11 Settings: setting cards, a toggle switch,
     a combobox, a checkbox, section expanders, an accent button and step dots. Ink tokens only (DynamicResource,
     defined in MainWindow.xaml), dark only. Merged into the window's resources by UI\Shell.ps1. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Toggle switch: "Off" / "On" / "Unchanged" label, then a 40 x 20 pill.
       Three-state (IsThreeState) for a Tweak whose State is Unknown or Custom: null = no change, dashed track. -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="L" Text="Off" Width="72" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"/>
            <Grid Width="40" Height="20" VerticalAlignment="Center">
              <Rectangle x:Name="Track" RadiusX="10" RadiusY="10" StrokeThickness="1" Stroke="{DynamicResource Mu}" Fill="{DynamicResource Ctl}"/>
              <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource Mu}"/>
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="14"/>
              <Setter TargetName="Thumb" Property="Height" Value="14"/>
              <Setter TargetName="Thumb" Property="Margin" Value="3,0"/>
              <Setter TargetName="Track" Property="Fill" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="L" Property="Text" Value="On"/>
              <Setter TargetName="Track" Property="Fill" Value="{DynamicResource Inv}"/>
              <Setter TargetName="Track" Property="Stroke" Value="{DynamicResource Inv}"/>
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource InvT}"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="L" Property="Text" Value="Unchanged"/>
              <Setter TargetName="L" Property="Foreground" Value="{DynamicResource Mu}"/>
              <Setter TargetName="Track" Property="StrokeDashArray" Value="2 2"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Thumb" Property="Width" Value="17"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Checkbox ("Run this" on an Action card): 20 px rounded box, white fill and black tick when checked. -->
  <Style x:Key="Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource Mu}" Background="{DynamicResource Ctl}" VerticalAlignment="Center">
              <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{DynamicResource Icons}" FontSize="12" Visibility="Collapsed"
                         Foreground="{DynamicResource InvT}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Inv}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Inv}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Combobox: control fill, 4 px corners, chevron; the drop-down is a rounded S1 surface. Editable keeps the same look. -->
  <Style x:Key="ComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Margin="4,2">
            <Border x:Name="B" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource Inv}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource Ctl}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Combo" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="MinWidth" Value="200"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Field" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="B" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CtlBd}" Background="{DynamicResource Ctl}">
                    <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Icons}" FontSize="10" Foreground="{DynamicResource Mu}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Shown" IsHitTestVisible="False" Margin="11,0,34,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Margin="8,0,34,0" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Tx}" CaretBrush="{DynamicResource Tx}"
                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" CornerRadius="8" Padding="0,4"
                      Background="{DynamicResource S2}" BorderBrush="{DynamicResource Bd}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Shown" Property="Visibility" Value="Hidden"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Setting card: one Tweak. Columns: text (name, description, state line), then the control. -->
  <Style x:Key="SettingCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource S1}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="16,12"/>
    <Setter Property="MinHeight" Value="68"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
  </Style>

  <!-- Section expander: a Category heading with a chevron; cards stack inside. Open by default. -->
  <Style x:Key="Section" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="IsExpanded" Value="True"/>
    <Setter Property="Margin" Value="0,0,0,16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="Head" Cursor="Hand" FocusVisualStyle="{x:Null}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <DockPanel Background="Transparent" Margin="0,0,0,8">
                    <TextBlock x:Name="Chev" DockPanel.Dock="Right" Text="&#xE70E;" FontFamily="{DynamicResource Icons}" FontSize="10"
                               Foreground="{DynamicResource Mu}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ContentPresenter VerticalAlignment="Center"/>
                  </DockPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="False">
                      <Setter TargetName="Chev" Property="Text" Value="&#xE70D;"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Tx}"/>
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Accent button (Next, Apply): white with black text, as Ink's primary. -->
  <Style x:Key="Accent" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource InvT}"/>
    <Setter Property="Background" Value="{DynamicResource Inv}"/>
    <Setter Property="Padding" Value="20,6"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="B" Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Mode card (Install AkariOS: One-click / Guided): a big clickable card, lighter on hover. -->
  <Style x:Key="ModeCard" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Bd}" BorderThickness="1"
                  CornerRadius="8" Padding="24,20" MinHeight="180">
            <ContentPresenter VerticalAlignment="Top"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Mu}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="B" Property="Background" Value="{DynamicResource S2}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="B" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Step dot: outlined; Tag="Current" fills it. -->
  <Style x:Key="StepDot" TargetType="Ellipse">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Stroke" Value="{DynamicResource Mu}"/>
    <Setter Property="StrokeThickness" Value="1"/>
    <Setter Property="Fill" Value="Transparent"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Current">
        <Setter Property="Fill" Value="{DynamicResource Inv}"/>
        <Setter Property="Stroke" Value="{DynamicResource Inv}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
