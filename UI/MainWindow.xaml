<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Akari" Width="1100" Height="720" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="Transparent" Foreground="{DynamicResource Tx}">
  <!-- The shell, after Akari-Dash's WinUI 3 window in its Akari theme: a wordmark title bar over
       Mica, a labelled sidebar, a page header with a large icon, title, subtitle and the search on
       the right, the page on one rounded bordered surface, and a status bar. The frame is extended
       over the whole window (GlassFrameThickness -1) so Windows draws Mica behind it; the window
       draws its own min / max / close buttons, since the black tint would dim Windows' ones. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6"
                  UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Ink tokens. Translucent where Akari-Dash's are, so a little Mica shows through. -->
    <SolidColorBrush x:Key="Bg" Color="#0A0A0A"/>
    <!-- Over Mica: Akari's near-black, with a hint of the glass left showing. -->
    <SolidColorBrush x:Key="Tint" Color="#E60A0A0A"/>
    <SolidColorBrush x:Key="Surf" Color="#B30F0F0F"/>
    <SolidColorBrush x:Key="S1" Color="#D9151515"/>
    <SolidColorBrush x:Key="S2" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="Bd" Color="#262626"/>
    <SolidColorBrush x:Key="Tx" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Mu" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="Ter" Color="#787878"/>
    <SolidColorBrush x:Key="Inv" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InvT" Color="#000000"/>
    <SolidColorBrush x:Key="Warn" Color="#FCE100"/>
    <SolidColorBrush x:Key="Bad" Color="#FF99A4"/>
    <SolidColorBrush x:Key="Ok" Color="#6CCB5F"/>
    <!-- WinUI's dark control fills: rest, hover, pressed, and the faint control stroke. -->
    <SolidColorBrush x:Key="Ctl" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="CtlH" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="CtlP" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="CtlBd" Color="#18FFFFFF"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Standard button. -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="{DynamicResource Ctl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
      <Setter Property="Padding" Value="12,5,12,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Accent button: white with black text, the Akari theme's accent. -->
    <Style x:Key="BtnP" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Inv}"/>
      <Setter Property="Foreground" Value="{DynamicResource InvT}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Inv}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Borderless icon button (the pane toggle). -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="4">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Ctl}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Title bar caption button (46 x 32, clickable inside the drag region). -->
    <Style x:Key="Cap" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Ctl}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CapX" TargetType="Button" BasedOn="{StaticResource Cap}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent">
              <ContentPresenter x:Name="C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#C42B1C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#C83C30"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sidebar item, after NavigationViewItem: rounded fill on hover and selection, and the
         white pill on the left of the selected one. Content is an icon + label grid built in code. -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Margin="4,2" Height="36">
              <Border x:Name="B" CornerRadius="4" Background="Transparent">
                <ContentPresenter x:Name="C" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{DynamicResource Inv}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Ctl}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlP}"/>
                <Setter TargetName="C" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text box, after WinUI's: faint fill, a grey underline that turns white and thicker on focus. -->
    <Style x:Key="Flat" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Background" Value="{DynamicResource Ctl}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CtlBd}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Tx}"/>
      <Setter Property="SelectionBrush" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="10,5,32,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </Border>
              <Border x:Name="Line" Height="1" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,4,4"
                      Background="#8BFFFFFF"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource CtlH}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="Background" Value="#B31E1E1E"/>
                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Inv}"/>
                <Setter TargetName="Line" Property="Height" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Read-only log text. -->
    <Style x:Key="LogBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Mu}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="SelectionBrush" Value="#FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Thin rounded scrollbar thumb, as WinUI's at rest. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="T" Background="#8BFFFFFF" CornerRadius="2" Width="4" Margin="0,4"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="T" Property="Width" Value="6"/>
                          <Setter TargetName="T" Property="CornerRadius" Value="3"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Tx}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="#FF2C2C2C" BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Padding="8,5,8,7">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Shell">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="PaneCol" Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Akari black behind the whole window: solid without Mica (Windows 10), a near-black tint over
         Mica when it is on (set in code). -->
    <Border x:Name="Body" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{DynamicResource Bg}"/>

    <!-- Title bar (drag region): icon, white dot, wordmark. -->
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
      <Image x:Name="Logo" Width="16" Height="16" Margin="0,0,8,0">
        <Image.Clip><EllipseGeometry Center="8,8" RadiusX="8" RadiusY="8"/></Image.Clip>
      </Image>
      <Ellipse Width="5" Height="5" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource Inv}"/>
      <TextBlock FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center">
        <Run Text="AKARI "/><Run Text="ULTIMATE"/>
      </TextBlock>
    </StackPanel>

    <!-- Caption buttons, drawn like Windows 11's: minimize, maximize / restore, close (red on hover). -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
      <Button x:Name="CapMin" Style="{StaticResource Cap}" ToolTip="Minimize">
        <TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="10"/>
      </Button>
      <Button x:Name="CapMax" Style="{StaticResource Cap}" ToolTip="Maximize">
        <TextBlock x:Name="CapMaxGlyph" Text="&#xE922;" FontFamily="{StaticResource Icons}" FontSize="10"/>
      </Button>
      <Button x:Name="CapClose" Style="{StaticResource CapX}" ToolTip="Close">
        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="10"/>
      </Button>
    </StackPanel>

    <!-- Sidebar -->
    <DockPanel Grid.Row="1" ClipToBounds="True">
      <Button x:Name="PaneToggle" DockPanel.Dock="Top" Style="{StaticResource Ghost}" Width="40" Height="36"
              HorizontalAlignment="Left" Margin="4,0,0,4" ToolTip="Collapse or expand the sidebar">
        <TextBlock Text="&#xE700;" FontFamily="{StaticResource Icons}" FontSize="16"/>
      </Button>
      <StackPanel x:Name="Nav"/>
    </DockPanel>

    <!-- Main -->
    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="120"/>
      </Grid.RowDefinitions>

      <!-- Page header: large icon, title, subtitle; the search on the right. -->
      <Grid Margin="2,0,16,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HeaderIcon" FontFamily="{StaticResource Icons}" FontSize="40" VerticalAlignment="Center"
                   Margin="0,0,16,0" Foreground="{DynamicResource Inv}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Heading" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="HeaderSub" Foreground="{DynamicResource Mu}" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Column="2" Width="280" VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBox x:Name="Search" Style="{StaticResource Flat}" ToolTip="Search all scripts"/>
          <TextBlock Text="Search all scripts" Foreground="{DynamicResource Mu}" Margin="11,0,0,1"
                     VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Mu}"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,1" IsHitTestVisible="False"/>
        </Grid>
      </Grid>

      <!-- The page's surface: one rounded, bordered panel. -->
      <Border Grid.Row="1" Margin="0,0,16,0" CornerRadius="8" BorderThickness="1"
              BorderBrush="{DynamicResource Bd}" Background="{DynamicResource Surf}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Page" Margin="24,20,24,20">

            <!-- Home page: host header + spec card grid -->
            <StackPanel x:Name="HomePanel" Visibility="Collapsed">
              <DockPanel x:Name="HomeHeader" Margin="0,0,0,16">
                <!-- copy specs button (right side) -->
                <Button x:Name="CopySpecs" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Copy specs"
                        ToolTip="Copy all specs as text" IsEnabled="False" Style="{StaticResource Btn}" MinWidth="104"/>
                <StackPanel>
                  <TextBlock x:Name="HostName" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold"
                             Foreground="{DynamicResource Tx}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="HostSub" FontSize="13" Foreground="{DynamicResource Mu}" Margin="0,4,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
              <WrapPanel x:Name="Cards" Orientation="Horizontal"/>
            </StackPanel>

            <StackPanel x:Name="Rows"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Log: what the scripts print, on its own rounded panel under the page. -->
      <Border Grid.Row="2" Margin="0,8,16,0" CornerRadius="8" BorderThickness="1"
              BorderBrush="{DynamicResource Bd}" Background="{DynamicResource Surf}">
        <TextBox x:Name="Log" Style="{StaticResource LogBox}" IsReadOnly="True"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Padding="14,8"/>
      </Border>
    </Grid>

    <!-- Status bar: Ready, or what is running now with a progress bar; the app name on the right. -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="16,6,16,6">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- the green dot at rest; a spinning ring while something runs -->
        <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Ok}"/>
        <Path x:Name="StatusRing" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
              Data="M7,1 A6,6 0 1 1 1,7" Stroke="{DynamicResource Inv}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
          <Path.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                   From="0" To="360" Duration="0:0:1"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Path.Triggers>
        </Path>
        <TextBlock x:Name="StatusText" Text="Ready" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource Mu}"
                   MaxWidth="520" TextTrimming="CharacterEllipsis"/>
        <!-- indeterminate progress bar -->
        <Border x:Name="StatusBar" Width="160" Height="3" Margin="12,0,0,0" CornerRadius="1.5" VerticalAlignment="Center"
                Background="#33FFFFFF" ClipToBounds="True" Visibility="Collapsed">
          <Rectangle Width="56" HorizontalAlignment="Left" Fill="{DynamicResource Inv}" RadiusX="1.5" RadiusY="1.5">
            <Rectangle.RenderTransform><TranslateTransform/></Rectangle.RenderTransform>
            <Rectangle.Triggers>
              <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="-56" To="160" Duration="0:0:1.4"/>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Rectangle.Triggers>
          </Rectangle>
        </Border>
      </StackPanel>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5" Text="AkariOS-Ultimate"
                 Foreground="{DynamicResource Ter}"/>
    </Grid>
  </Grid>
</Window>
