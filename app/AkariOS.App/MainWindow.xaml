<!-- The native window, as src/UI/MainWindow.xaml's: the frame extended over the whole window (GlassFrameThickness -1)
     so Windows draws Mica behind it, a 64 px caption, Akari's own caption buttons (batch 3, the shell). N2 batch 1:
     the body on the theme and the A mark; the shell comes next. -->
<Window x:Class="AkariOS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AkariOS" Width="1360" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource FontText}" FontSize="14" FontWeight="Medium"
        Background="Transparent" Foreground="{DynamicResource Tx}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="64" GlassFrameThickness="-1" ResizeBorderThickness="6"
                  UseAeroCaptionButtons="False" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Shell">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="Body" Grid.RowSpan="2" Background="{DynamicResource Bg}"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,24,0">
      <Image x:Name="Logo" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="AkariOS" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock x:Name="VersionText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"
               FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource Mu}"/>
  </Grid>
</Window>
