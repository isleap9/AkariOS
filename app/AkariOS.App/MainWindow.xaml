<Window
    x:Class="AkariOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:AkariOS.App.Shell">

    <Grid x:Name="RootElement" Background="Transparent" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- Ctrl+F / Ctrl+E: the search box from anywhere (Enter-AkariSearch); Alt+Left: back -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnSearchKey" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnSearchKey" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnBackKey" />
        </Grid.KeyboardAccelerators>
        <!-- Windows' own title bar (the design's page D): the pane holds the menu button (compact mode), the logo and the
             search box; no back arrow (Alt+Left still goes back) -->
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            BackRequested="OnNavBack"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Auto"
            OpenPaneLength="300"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1000"
            ItemInvoked="OnNavInvoked">
            <!-- the pane's header: the logo, AkariOS and its version (Settings' account header, the AkariOS way) -->
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,8,0,12">
                    <Grid Width="48" Height="48">
                        <!-- the logo's glow: the accent fading out (none in high contrast: AkariGlowOpacity) -->
                        <Ellipse Opacity="{ThemeResource AkariGlowOpacity}">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image x:Name="Logo" Width="36" Height="36" Stretch="Uniform" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="AkariOS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search tweaks" QueryIcon="Find"
                                TextChanged="OnSearchTyped" QuerySubmitted="OnSearchSubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="shell:SearchSuggestion">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind Where}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <Grid>
                <!-- a page comes in with WinUI's own entrance (rises and fades in) -->
                <Frame x:Name="ContentFrame">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
                <!-- the first run's tip next to the search box (Show-AkariSearchTip) -->
                <TeachingTip x:Name="SearchTipView" Target="{x:Bind SearchBox}" PreferredPlacement="Right" IsLightDismissEnabled="True"
                             Title="Search every Tweak" ActionButtonContent="Got it" ActionButtonStyle="{StaticResource AccentButtonStyle}"
                             ActionButtonClick="OnSearchTipGotIt" Closed="OnSearchTipClosed" />
                <!-- the toasts (Show-AkariToast, Set-Busy), stacked at the bottom right on the glass: results newest on
                     top, the busy toast under them -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="380" Spacing="8">
                    <ItemsControl ItemsSource="{x:Bind Shell.Toasts}">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="shell:Toast">
                                <InfoBar IsOpen="True" IsClosable="True" Severity="{x:Bind Severity}" Title="{x:Bind Title}" Message="{x:Bind Text}"
                                         CloseButtonCommand="{x:Bind CloseCommand}"
                                         Background="{ThemeResource AkariGlassBrush}">
                                    <InfoBar.ActionButton>
                                        <Button Content="{x:Bind ActionText}" Command="{x:Bind ActCommand}" Visibility="{x:Bind HasAction}" />
                                    </InfoBar.ActionButton>
                                </InfoBar>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- the busy toast (Set-Busy): what runs now and, for a Run, how far it got -->
                    <InfoBar
                        Severity="Informational" IsClosable="False"
                        IsOpen="{x:Bind Shell.IsBusy, Mode=OneWay}" Title="{x:Bind Shell.BusyText, Mode=OneWay}"
                        Background="{ThemeResource AkariGlassBrush}">
                        <ProgressBar IsIndeterminate="{x:Bind Shell.Indeterminate, Mode=OneWay}" Value="{x:Bind Shell.ProgressValue, Mode=OneWay}"
                                     Maximum="100" Margin="0,0,0,12" />
                    </InfoBar>
                </StackPanel>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
