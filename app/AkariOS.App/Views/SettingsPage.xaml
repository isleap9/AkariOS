<Page
    x:Class="AkariOS.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <Page.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme" />
                        <TextBlock Text="Select which app theme to display" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="200" ItemsSource="{x:Bind ViewModel.Themes}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay, Converter={StaticResource PassThrough}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToStringConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE2B1;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Accent colour" />
                        <TextBlock Text="Akari crimson, or your Windows accent" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" VerticalAlignment="Center" MinWidth="200" ItemsSource="{x:Bind ViewModel.Accents}" SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Settings files -->
            <TextBlock Text="Settings files" Style="{StaticResource Section}" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B5;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Import settings" />
                        <TextBlock Text="Load an exported file or any preset into Guided, where you review the changes before applying them."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Import..." VerticalAlignment="Center" Command="{x:Bind ViewModel.ImportCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEDE1;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Export settings" />
                        <TextBlock Text="Save the settings this PC has (every AkariOS tweak that is applied, and each choice) to a file. Apps are not part of it."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Export..." VerticalAlignment="Center" Command="{x:Bind ViewModel.ExportCommand}" />
                </Grid>
            </Border>

            <!-- Recovery -->
            <TextBlock Text="Recovery" Style="{StaticResource Section}" />
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE777;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="System Restore" />
                        <TextBlock Text="Open Windows' restore points" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenSystemRestoreCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9F9;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Logs" />
                        <TextBlock Text="{x:Bind ViewModel.LogFolder}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open folder" VerticalAlignment="Center" Command="{x:Bind ViewModel.OpenLogFolderCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7A7;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Undo the last run" />
                        <TextBlock Text="Put back the values the last Guided or One-click Run changed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Undo…" VerticalAlignment="Center" Command="{x:Bind ViewModel.UndoCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Check my setup" />
                        <TextBlock Text="Find the AkariOS settings Windows changed back, e.g. after an update" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Check" VerticalAlignment="Center" Command="{x:Bind ViewModel.CheckSetupCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEBE8;" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Save a support file" />
                        <TextBlock Text="A zip of the logs and this PC's details for a bug report; your names are left out" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Save…" VerticalAlignment="Center" Command="{x:Bind ViewModel.SaveSupportFileCommand}" />
                </Grid>
            </Border>

            <!-- About: the version and update status, What's new, links, credits, license -->
            <TextBlock Text="About" Style="{StaticResource Section}" />
            <!-- plain cards, not an Expander: an expanded Expander keeps the width it was measured at, so the page didn't
                 grow or shrink with the navigation pane -->
            <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Image x:Name="AboutLogo" Width="20" Height="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.VersionText}" />
                            <TextBlock Text="{x:Bind ViewModel.Updates.StatusText, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Update now" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UpdateNowCommand}"
                                    Visibility="{x:Bind ViewModel.Updates.CanInstall, Mode=OneWay}" />
                            <Button Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                        </StackPanel>
                    </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Updates.HasNotes, Mode=OneWay}">
                        <TextBlock Text="What's new" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Updates.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Links" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.About.Links}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LinkItem">
                                    <HyperlinkButton Content="{x:Bind Name}" Click="OnLink" Tag="{x:Bind Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Credits" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.About.Credits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LinkItem">
                                    <StackPanel Margin="0,0,0,6">
                                        <HyperlinkButton Content="{x:Bind Name}" Click="OnLink" Tag="{x:Bind Url}" Padding="0" />
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Content="Every credit, tweak by tweak" Click="OnLink" Tag="{x:Bind ViewModel.About.FullCredits}" Padding="0" />
                    </StackPanel>

                    <HyperlinkButton Content="{x:Bind ViewModel.About.License}" Click="OnLink" Tag="{x:Bind ViewModel.About.LicenseUrl}" Padding="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
