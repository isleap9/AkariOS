<Page
    x:Class="AkariOS.App.Views.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AkariOS.App.Views"
    xmlns:vm="using:AkariOS.App.ViewModels"
    xmlns:controls="using:AkariOS.App.Controls">

    <!-- the Aurora banner (the design's page D), Optimize's light -->
    <Grid>
    <controls:AuroraBackdrop Palette="Optimize" />
    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <controls:PageBanner Title="Optimize" Lead="{x:Bind vm:OptimizeViewModel.Lead}" />

            <!-- the Sections, two to a row (glass rows: icon, header, its first Categories, the count, a chevron) -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sections}">
                <ItemsRepeater.Layout>
                    <views:CardGridLayout MinItemWidth="340" ColumnSpacing="4" RowSpacing="4" MaxColumns="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:OptimizeSection">
                        <Button Style="{StaticResource GlassRow}" Tag="{x:Bind Key}" Click="OnSection">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Style="{StaticResource TileIcon}" Width="36" Height="36" Margin="0" VerticalAlignment="Center"><FontIcon Glyph="{x:Bind Glyph}" FontSize="16" /></ContentControl>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Header}" />
                                    <TextBlock Text="{x:Bind Categories}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind CountText}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Tools: the Catalogue's own cards -->
            <TextBlock Text="Tools" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" Visibility="{x:Bind ViewModel.HasTools}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Tools}" ItemTemplate="{StaticResource CardTemplate}" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
