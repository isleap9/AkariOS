<Page
    x:Class="AkariOS.App.Views.IsoBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <Page.Resources>
        <!-- a card's heading and its line under it -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <!-- a radio's or check box's own choices, indented under it (New-AkariIsoBranch) -->
        <Style x:Key="Branch" TargetType="StackPanel">
            <Setter Property="Margin" Value="28,2,0,8" />
            <Setter Property="Spacing" Value="8" />
        </Style>

        <DataTemplate x:Key="OptionTemplate" x:DataType="vm:IsoOptionViewModel">
            <StackPanel Margin="0,2,0,6">
                <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind Description}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource Note}" Margin="28,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ImageItemTemplate" x:DataType="vm:ImageItemViewModel">
            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinHeight="28" Padding="8,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- a Store app's icon; the other lists have none -->
                    <ContentControl Width="20" Height="20" Visibility="{x:Bind HasIcon}" Content="{x:Bind Icon}"
                                    ContentTemplate="{StaticResource AppIconTemplate}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <DataTemplate x:Key="ImageListTemplate" x:DataType="vm:ImageListViewModel">
            <StackPanel Visibility="{x:Bind Shown, Mode=OneWay}" Margin="0,8,0,0">
                <TextBlock Text="{x:Bind Heading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                <ScrollViewer MaxHeight="240" Padding="0,0,16,0">
                    <ItemsRepeater ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource ImageItemTemplate}" />
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="0">
            <TextBlock Text="ISO Builder" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16"
                       Text="A Windows 11 ISO with apps removed, settings made and AkariOS on it, after zoicware's zISO Tweaker. Your own Windows is not changed." />

            <!-- 1 the ISO -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="1  Windows 11 ISO" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Note}" Margin="0,0,0,8"
                               Text="An ISO you have, or one downloaded here. AkariOS copies it to a work folder, so the ISO itself is not changed." />

                    <RadioButton GroupName="IsoSource" Content="An ISO file I have" IsChecked="{x:Bind ViewModel.IsFile, Mode=TwoWay}" />
                    <StackPanel Style="{StaticResource Branch}" Orientation="Horizontal" Visibility="{x:Bind ViewModel.IsFile, Mode=OneWay}">
                        <TextBox Text="{x:Bind ViewModel.IsoPath, Mode=TwoWay}" Width="420" PlaceholderText="C:\Users\you\Downloads\Win11.iso" />
                        <Button Content="Browse…" Command="{x:Bind ViewModel.PickIsoCommand}" />
                    </StackPanel>

                    <RadioButton GroupName="IsoSource" Content="Download with UUP Dump (23H2 to 26H2, any language, Home to IoT Enterprise)"
                                 IsChecked="{x:Bind ViewModel.IsUup, Mode=TwoWay}" />
                    <StackPanel Style="{StaticResource Branch}" Visibility="{x:Bind ViewModel.IsUup, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{x:Bind ViewModel.UupVersions}" SelectedIndex="{x:Bind ViewModel.UupVersionIndex, Mode=TwoWay}"
                                      PlaceholderText="Version" MinWidth="170" IsEnabled="{x:Bind ViewModel.Idle, Mode=OneWay}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.UupLanguages, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.UupLanguageIndex, Mode=TwoWay}"
                                      PlaceholderText="Language" MinWidth="220" IsEnabled="{x:Bind ViewModel.Idle, Mode=OneWay}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.UupEditions, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.UupEditionIndex, Mode=TwoWay}"
                                      PlaceholderText="Edition" MinWidth="200" />
                        </StackPanel>
                        <Button Content="Download" Command="{x:Bind ViewModel.UupDownloadCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.UupNote, Mode=OneWay}" Style="{StaticResource Note}" />
                    </StackPanel>

                    <RadioButton GroupName="IsoSource" Content="Download from Massgrave (LTSC, IoT LTSC, consumer and business media)"
                                 IsChecked="{x:Bind ViewModel.IsMassgrave, Mode=TwoWay}" />
                    <StackPanel Style="{StaticResource Branch}" Visibility="{x:Bind ViewModel.IsMassgrave, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{x:Bind ViewModel.MassgraveProducts, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.MassgraveProductIndex, Mode=TwoWay}"
                                      PlaceholderText="Product" MinWidth="320" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.MassgraveFiles, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.MassgraveFileIndex, Mode=TwoWay}"
                                      PlaceholderText="Language" MinWidth="220" />
                        </StackPanel>
                        <Button Command="{x:Bind ViewModel.OpenMassgravePageCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                <TextBlock Text="Open download page" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Bind ViewModel.MassgraveNote, Mode=OneWay}" Style="{StaticResource Note}" />
                    </StackPanel>

                    <TextBlock Text="Work and output folder (NTFS, 25 GB free; the ISO is saved here)" Margin="0,12,0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{x:Bind ViewModel.OutDir, Mode=TwoWay}" Width="420" />
                        <Button Content="Browse…" Command="{x:Bind ViewModel.PickFolderCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                        <Button Content="Open ISO" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.OpenIsoCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.OpenNote, Mode=OneWay}" Style="{StaticResource Note}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2 the edition -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="2  Edition" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="The ISO keeps only this edition." Style="{StaticResource Note}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.Editions, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.EditionIndex, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.EditionEnabled, Mode=OneWay}" PlaceholderText="Open the ISO first" MinWidth="340" />
                </StackPanel>
            </Border>

            <!-- 3 the answer file -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="3  Answer file" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="autounattend.xml at the root of the ISO: Windows setup reads it by itself." Style="{StaticResource Note}" Margin="0,0,0,8" />
                    <RadioButton GroupName="IsoAnswer" Content="None: setup asks everything as usual" IsChecked="{x:Bind ViewModel.AnswerNone, Mode=TwoWay}" />
                    <RadioButton GroupName="IsoAnswer" Content="A local account (this PC's language, keyboard and time zone; setup still asks for the disk)"
                                 IsChecked="{x:Bind ViewModel.AnswerLocal, Mode=TwoWay}" />
                    <StackPanel Style="{StaticResource Branch}" Visibility="{x:Bind ViewModel.AnswerLocal, Mode=OneWay}">
                        <CheckBox Content="Skip the setup questions (OOBE) and create this administrator" IsChecked="{x:Bind ViewModel.SkipOobe, Mode=TwoWay}" />
                        <StackPanel Style="{StaticResource Branch}" Visibility="{x:Bind ViewModel.SkipOobe, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Header="User name" Text="{x:Bind ViewModel.User, Mode=TwoWay}" Width="200" />
                                <TextBox Header="Password" Text="{x:Bind ViewModel.Password, Mode=TwoWay}" Width="200" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}"
                                       Text="The password is in the answer file (Base64, not encrypted): anyone with the ISO can read it. Leave it empty for none." />
                        </StackPanel>
                    </StackPanel>
                    <RadioButton GroupName="IsoAnswer" Content="The Unattend Generator's choices (Install USB)" IsChecked="{x:Bind ViewModel.AnswerGenerator, Mode=TwoWay}" />
                    <StackPanel Style="{StaticResource Branch}" Visibility="{x:Bind ViewModel.AnswerGenerator, Mode=OneWay}">
                        <HyperlinkButton Content="Open Install USB to make your choices" Command="{x:Bind ViewModel.OpenUnattendCommand}" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4-6 zISO's options; 6 also the image's own lists -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IsoGroupViewModel">
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{x:Bind Options}" ItemTemplate="{StaticResource OptionTemplate}" />
                                <!-- 6 Apps: the image's own apps and features -->
                                <StackPanel Visibility="{x:Bind HasLists}" Spacing="8" Margin="0,12,0,0">
                                    <TextBlock Text="Apps and features in the image" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Read the image's apps" Command="{x:Bind Owner.ReadImageCommand}" />
                                        <Button Content="Select recommended" Command="{x:Bind Owner.SelectRecommendedCommand}" />
                                        <Button Content="Clear" Command="{x:Bind Owner.ClearListsCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Owner.ListNote, Mode=OneWay}" Style="{StaticResource Note}" />
                                    <ItemsControl ItemsSource="{x:Bind Owner.Lists}" ItemTemplate="{StaticResource ImageListTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 7 AkariOS -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="4">
                    <TextBlock Text="7  AkariOS" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <CheckBox Content="Put AkariOS on the new Windows (C:\AkariOS, a Start menu and a desktop shortcut; nothing runs by itself)"
                              IsChecked="{x:Bind ViewModel.AkariOS, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.AkariOSEnabled}" />
                    <TextBlock Text="{x:Bind ViewModel.AkariOSNote}" Style="{StaticResource Note}" Visibility="{x:Bind ViewModel.HasAkariOSNote}" Margin="28,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Build -->
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Build" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Note}"
                               Text="Allow 20 to 40 minutes. Optimize's changes and installs wait meanwhile; the busy toast shows each step." />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasBuildError, Mode=OneWay}" Severity="Error" Title="Not built"
                             Message="{x:Bind ViewModel.BuildError, Mode=OneWay}" IsClosable="False" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}" Severity="Success" Title="Your ISO is ready"
                             Message="{x:Bind ViewModel.ResultPath, Mode=OneWay}" IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button Content="Open folder" Command="{x:Bind ViewModel.OpenOutFolderCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Button Content="Build ISO" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.BuildCommand}" MinWidth="120" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
