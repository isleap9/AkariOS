<Page
    x:Class="AkariOS.App.Views.CataloguePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels"
    xmlns:views="using:AkariOS.App.Views">

    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
            <!-- the title (Set-AkariHeader): the way here as a line of links (Optimize › Customize ›), then the heading -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.CrumbLinks, Mode=OneWay}" ItemTemplate="{StaticResource CrumbTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

            <!-- the Catalogue's bars (Update-AkariCatalogueBars): Safe Mode changes waiting, restarts needed -->
            <InfoBar Severity="Warning" IsClosable="False" Title="Safe Mode"
                     IsOpen="{x:Bind ViewModel.Catalogue.SafeBarOpen, Mode=OneWay}" Message="{x:Bind ViewModel.Catalogue.SafeBarText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Restart into Safe Mode" Command="{x:Bind ViewModel.Catalogue.SafeRunCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Severity="Informational" IsClosable="False" Title="Restart required"
                     IsOpen="{x:Bind ViewModel.Catalogue.RestartBarOpen, Mode=OneWay}" Message="{x:Bind ViewModel.Catalogue.RestartBarText, Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="Restart Explorer" Command="{x:Bind ViewModel.Catalogue.RestartExplorerCommand}"
                                Visibility="{x:Bind ViewModel.Catalogue.CanRestartExplorer, Mode=OneWay}" />
                        <Button Content="Restart now" Command="{x:Bind ViewModel.Catalogue.RestartPcCommand}"
                                Visibility="{x:Bind ViewModel.Catalogue.CanRestartPc, Mode=OneWay}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- a Section's page (Windows 11 Settings' look): its Categories in groups, each row opening the Category's
                 own page -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryGroups, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsDrill, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryGroup">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,6"
                                       Visibility="{x:Bind HasTitle}" />
                            <ItemsControl ItemsSource="{x:Bind Links}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryLink">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,10" MinHeight="68" Margin="0,0,0,4"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Tag="{x:Bind Key}" Click="OnCategoryCard">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="10" Padding="8,2"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind Count}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,4" Visibility="{x:Bind ViewModel.HasCards, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.RefreshCommand}" ToolTipService.ToolTip="Read the current state of these tweaks again">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ItemsControl x:Name="GroupList" ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CatalogueGroup">
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource CardTemplate}" />
                            <views:ServicesListView DataContext="{x:Bind Services}" Visibility="{x:Bind HasServices}" />
                            <views:TasksListView DataContext="{x:Bind Tasks}" Visibility="{x:Bind HasTasks}" />
                            <views:StartupListView DataContext="{x:Bind Startup}" Visibility="{x:Bind HasStartup}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
