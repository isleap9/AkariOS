<ResourceDictionary
    x:Class="AkariOS.App.Views.Cards"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <!-- the settings card the Catalogue pages and Home's Quick settings share (merged in App.xaml) -->
    <!-- a settings card (the prototype's .card): WinUI's card fill and stroke, 4 px corners -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="CardTemplate" x:DataType="vm:TweakCardViewModel">
        <Border Style="{StaticResource CardBorder}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Bind Id}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Border Style="{StaticResource Badge}" Visibility="{x:Bind IsAkariOS}" Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="AkariOS" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Visibility="{x:Bind HasRiskBadge}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock Text="{x:Bind RiskBadge}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind ShowPlainLine, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind ShowWarnLine, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind ShowErrorLine, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{x:Bind NotNativeText}" Visibility="{x:Bind IsNotNative}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <!-- marks: restart required, runs in Safe Mode -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE777;" FontSize="14" Visibility="{x:Bind Reboots}" ToolTipService.ToolTip="Restart required"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Glyph="&#xEA18;" FontSize="14" Visibility="{x:Bind InSafeMode}" ToolTipService.ToolTip="Runs in Safe Mode: AkariOS restarts into it and back"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <ToggleSwitch Visibility="{x:Bind IsToggle}" IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                  OnContent="On" OffContent="Off" MinWidth="0" />
                    <ComboBox Visibility="{x:Bind IsChoice}" Width="240" ItemsSource="{x:Bind Choices}"
                              SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" />
                    <Button Visibility="{x:Bind IsAction}" Content="{x:Bind ButtonText}" MinWidth="96"
                            Command="{x:Bind RunCommand}" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
