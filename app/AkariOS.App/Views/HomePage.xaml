<Page
    x:Class="AkariOS.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels"
    xmlns:controls="using:AkariOS.App.Controls">

    <!-- the Aurora banner (the design's page D): the page's light behind everything, the content over it on glass -->
    <Grid>
    <controls:AuroraBackdrop Palette="Home" Tall="True" />
    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
            <!-- WinUI's entrance: the banner, the facts and each section rise in one after another -->
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <!-- the update InfoBar (About.ps1's check), dismissible -->
            <InfoBar Severity="Informational" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.UpdateBarOpen, Mode=OneWay}" Title="{x:Bind ViewModel.Updates.FoundTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.UpdateBarText, Mode=OneWay}" CloseButtonCommand="{x:Bind ViewModel.DismissUpdateCommand}">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="Update" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UpdateNowCommand}"
                                Visibility="{x:Bind ViewModel.Updates.CanInstall, Mode=OneWay}" />
                        <Button Content="What's new" Command="{x:Bind ViewModel.WhatsNewCommand}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- the drift check's InfoBar (X3): AkariOS settings Windows changed back, dismissible -->
            <InfoBar Severity="Warning" IsClosable="True"
                     IsOpen="{x:Bind ViewModel.DriftBarOpen, Mode=OneWay}" Title="{x:Bind ViewModel.DriftTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.DriftMessage}" CloseButtonCommand="{x:Bind ViewModel.DismissDriftCommand}">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="Review" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ReviewDriftCommand}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- the banner (New-AkariHero): the logo, the headline, Start One-click and Choose changes, straight on the light -->
            <Grid MinHeight="220" ColumnSpacing="28" Padding="4,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="HeroLogo" Width="112" Height="112" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Overline}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Headline}" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.Lead}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.OneClickCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="16" />
                                <TextBlock Text="Start One-click" />
                            </StackPanel>
                        </Button>
                        <Button Content="Choose changes" Command="{x:Bind ViewModel.ChooseChangesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- the facts (Start-AkariHomeStats) as glass tiles: Tweaks, apps you can remove, changes applied ("—" until read) -->
            <Grid x:Name="Facts" ColumnSpacing="8">
                <!-- its cards rise one after another (page D staggers a grid's cards too) -->
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource GlassCard}" Padding="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ContentControl Style="{StaticResource TileIcon}" Width="36" Height="36" Margin="0"><FontIcon Glyph="&#xE9E9;" FontSize="16" /></ContentControl>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Stats.TweaksText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Tweaks" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ContentControl Style="{StaticResource TileIcon}" Width="36" Height="36" Margin="0"><FontIcon Glyph="&#xE74D;" FontSize="16" /></ContentControl>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Stats.AppsText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Apps you can remove" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ContentControl Style="{StaticResource TileIcon}" Width="36" Height="36" Margin="0"><FontIcon Glyph="&#xE73E;" FontSize="16" /></ContentControl>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Stats.AppliedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Changes applied" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Get started" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <Grid x:Name="Tiles" ColumnSpacing="8" RowSpacing="8">
                <!-- its cards rise one after another (page D staggers a grid's cards too) -->
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GlassTile}" Command="{x:Bind ViewModel.OneClickCommand}">
                    <StackPanel Spacing="6">
                        <ContentControl Style="{StaticResource TileIcon}"><FontIcon Glyph="&#xE945;" FontSize="18" /></ContentControl>
                        <TextBlock Text="One-click" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="The full AkariOS setup: apps, drivers, Safe Mode and tweaks, with restarts handled for you." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Recommended for a fresh install" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource GlassTile}" Command="{x:Bind ViewModel.ChooseChangesCommand}">
                    <StackPanel Spacing="6">
                        <ContentControl Style="{StaticResource TileIcon}"><FontIcon Glyph="&#xE8A5;" FontSize="18" /></ContentControl>
                        <TextBlock Text="Guided" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Pick the apps to remove and the Tweaks to apply, review, then apply in one go." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="For a PC you already use" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource GlassTile}" Command="{x:Bind ViewModel.OptimizeCommand}">
                    <StackPanel Spacing="6">
                        <ContentControl Style="{StaticResource TileIcon}"><FontIcon Glyph="&#xE9E9;" FontSize="18" /></ContentControl>
                        <TextBlock Text="Optimize" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Every Tweak by category. Each change applies the moment you flip it." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="For power users" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- X6: Since AkariOS, the numbers before the last Run and after its restart -->
            <TextBlock Text="Since AkariOS" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" Visibility="{x:Bind ViewModel.HasSince, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.SinceRows, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSince, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SinceRow">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEC4A;" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Text}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Bind ViewModel.SinceNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasSince, Mode=OneWay}" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Quick settings: four AkariOS Tweaks as the Catalogue's own cards (they act right away) -->
            <TextBlock Text="Quick settings" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" Visibility="{x:Bind ViewModel.HasQuickSettings}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.QuickSettings}" ItemTemplate="{StaticResource CardTemplate}" />

            <TextBlock Text="Recent activity" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,4" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityItem">
                        <Border Style="{StaticResource CardBorder}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE930;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind CountText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind ViewModel.HasNoActivity, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE81C;" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Nothing applied yet" />
                        <TextBlock Text="Runs from One-click, Guided and Optimize show up here." Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
