<Page
    x:Class="AkariOS.App.Views.UnattendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
            <TextBlock Text="Install USB" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                       Text="An autounattend.xml for a Windows install USB: accounts, language, edition, disk and setup choices, after Christoph Schneegans' generator." />

            <!-- the drive bar (.usbbar): the USB found, Refresh, Save to a folder..., the accent Save to USB -->
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE88E;" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.DriveName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.DriveNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.DriveNames, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.DriveIndex, Mode=TwoWay}"
                                  Visibility="{x:Bind ViewModel.HasDriveChoice, Mode=OneWay}" MinWidth="260" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.RefreshDrivesCommand}" ToolTipService.ToolTip="Look for a Windows setup USB again">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <Button Content="Save to a folder…" Command="{x:Bind ViewModel.SaveToFolderCommand}"
                                ToolTipService.ToolTip="Save autounattend.xml anywhere, to copy it to a USB later" />
                        <Button Content="Save to USB" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveToUsbCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSaveToUsb, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- the generator's own checks -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Title="Not saved" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsClosable="False" />

            <!-- the command bar -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                <Button Command="{x:Bind ViewModel.OpenCommand}" ToolTipService.ToolTip="A file made on Schneegans' site or by AkariOS">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Open file…" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ResetCommand}" ToolTipService.ToolTip="Every section back to the defaults and this PC's settings">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                        <TextBlock Text="Reset to defaults" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- his sections, one expander each (built in code: UnattendFormView) -->
            <StackPanel x:Name="Sections" Spacing="4" />
        </StackPanel>
    </ScrollViewer>
</Page>
