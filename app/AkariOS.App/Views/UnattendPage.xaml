<Page
    x:Class="AkariOS.App.Views.UnattendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariOS.App.Controls">

    <!-- the Aurora banner (the design's page D), Install USB's light -->
    <Grid>
    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <controls:AuroraBackdrop Palette="Usb" Grid.RowSpan="2" />
    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
            <!-- the banner; the command bar (Open file..., Reset to defaults) on its right -->
            <controls:PageBanner Title="Install USB"
                                 Lead="An autounattend.xml for a Windows install USB: accounts, language, edition, disk and setup choices, after Christoph Schneegans' generator.">
                <controls:PageBanner.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.OpenCommand}" ToolTipService.ToolTip="A file made on Schneegans' site or by AkariOS">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="Open file…" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ResetCommand}" ToolTipService.ToolTip="Every section back to the defaults and this PC's settings">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Reset to defaults" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls:PageBanner.Actions>
            </controls:PageBanner>

            <!-- 1 Drive (the design's numbered sections): the setup USB found and Refresh, on the glass; the saves are
                 in the footer -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,8,0,4">
                <TextBlock Text="1" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Drive" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <Border Style="{StaticResource GlassCard}">
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE88E;" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.DriveName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.DriveNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.DriveNames, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.DriveIndex, Mode=TwoWay}"
                                  Visibility="{x:Bind ViewModel.HasDriveChoice, Mode=OneWay}" MinWidth="260" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="DriveButtons" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.RefreshDrivesCommand}" ToolTipService.ToolTip="Look for a Windows setup USB again">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- the generator's own checks -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Title="Not saved" Message="{x:Bind ViewModel.Error, Mode=OneWay}" IsClosable="False" />

            <!-- 2 Setup choices: his sections, one expander each (built in code: UnattendFormView) -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,16,0,4">
                <TextBlock Text="2" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Setup choices" Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
            <StackPanel x:Name="Sections" Spacing="4" />
        </StackPanel>
    </ScrollViewer>

    <!-- the footer on the glass (the design's): the USB it saves to, Save to a folder..., the accent Save to USB -->
    <Border Grid.Row="1" Padding="36,12"
            Background="{ThemeResource AkariGlassBrush}" BorderBrush="{ThemeResource AkariGlassStrokeBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.DriveName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Content="Save to a folder…" Command="{x:Bind ViewModel.SaveToFolderCommand}"
                    ToolTipService.ToolTip="Save autounattend.xml anywhere, to copy it to a USB later" />
            <Button Grid.Column="2" Content="Save to USB" Style="{StaticResource AccentButtonStyle}" MinWidth="110"
                    Command="{x:Bind ViewModel.SaveToUsbCommand}" IsEnabled="{x:Bind ViewModel.CanSaveToUsb, Mode=OneWay}" />
        </Grid>
    </Border>
    </Grid>
</Page>
