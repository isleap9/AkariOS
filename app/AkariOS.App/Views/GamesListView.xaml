<UserControl
    x:Class="AkariOS.App.Views.GamesListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <!-- DataContext: a GamesListViewModel (Optimize › Gaming's per-game settings, under its Tweaks) -->
    <StackPanel Spacing="8" Margin="0,16,0,0">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search games" QueryIcon="Find" Text="{Binding Query, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Add a game…" Command="{Binding AddCommand}" ToolTipService.ToolTip="A game the list misses: pick its program (.exe)" />
            <Button Grid.Column="2" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Look for games again">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Text="{Binding CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ItemsRepeater ItemsSource="{Binding Shown}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:GameRowViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="16,10" Margin="0,0,0,4">
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Content="Remove from list" HorizontalAlignment="Right" Command="{x:Bind RemoveCommand}" Visibility="{x:Bind IsAdded}" />
                            </Grid>
                            <TextBlock Text="{x:Bind Meta}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Exe}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="24" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GameSwitchViewModel">
                                        <ToggleSwitch Header="{x:Bind Label}" OnContent="On" OffContent="Off" MinWidth="0"
                                                      IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Tip}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind ShowPlainLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind IsError, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
