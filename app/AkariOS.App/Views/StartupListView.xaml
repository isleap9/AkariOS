<UserControl
    x:Class="AkariOS.App.Views.StartupListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <!-- DataContext: a StartupListViewModel (Tools › Startup's list, under its Tweak) -->
    <StackPanel Spacing="8" Margin="0,16,0,0">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding FilterChoices}" SelectedValuePath="Value" SelectedValue="{Binding Filter, Mode=TwoWay}" MinWidth="150" />
            <AutoSuggestBox Grid.Column="1" PlaceholderText="Search startup apps" QueryIcon="Find" Text="{Binding Query, Mode=TwoWay}" />
            <Button Grid.Column="2" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Read the startup apps again">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Text="{Binding CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ItemsRepeater ItemsSource="{Binding Shown}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:StartupRowViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="16,10" Margin="0,0,0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind Publisher}" Visibility="{x:Bind HasPublisher}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Command}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Command}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind ShowPlainLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind IsError, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Remove" VerticalAlignment="Center" Command="{x:Bind RemoveCommand}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                    ToolTipService.ToolTip="Delete the entry: its registry value or its Startup folder shortcut" />
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" OnContent="On" OffContent="Off" MinWidth="0"
                                          IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}"
                                          ToolTipService.ToolTip="On: it starts with Windows. Off: it stays, but does not start (as Task Manager turns it off)." />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
