<Page
    x:Class="AkariOS.App.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels"
    xmlns:local="using:AkariOS.App.Views"
    xmlns:controls="using:AkariOS.App.Controls">

    <Page.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- a panel on the glass (the design's page D): what One-click does, the counts, the run's list -->
        <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource GlassCard}" />

        <!-- a Guided Tweaks row (New-AkariTweakRow): a checkbox with the name and its description, or the text with a
             dropdown starting on "No change"; then the badges (AkariOS, Caution / Advanced) and marks (restart, Safe
             Mode, a custom or unknown State) -->
        <DataTemplate x:Key="TweakRowTemplate" x:DataType="vm:TweakRowViewModel">
            <Grid Visibility="{x:Bind Shows, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Tip}" Padding="0,8" ColumnSpacing="12" MinHeight="48"
                  BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Visibility="{x:Bind IsCheck}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CheckBox>
                <StackPanel Visibility="{x:Bind IsChoice}" VerticalAlignment="Center" Margin="32,0,0,0">
                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Style="{StaticResource Badge}" Visibility="{x:Bind IsAkariOS}" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="AkariOS" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Visibility="{x:Bind HasRiskBadge}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                        <TextBlock Text="{x:Bind RiskBadge}" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Border>
                    <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind Reboots}" ToolTipService.ToolTip="Restart required"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Visibility="{x:Bind InSafeMode}" ToolTipService.ToolTip="Runs in Safe Mode: AkariOS restarts into it and back"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Glyph="&#xE9CE;" FontSize="14" Visibility="{x:Bind StateUnread}" ToolTipService.ToolTip="{x:Bind StateTip}"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ComboBox Grid.Column="2" Visibility="{x:Bind IsChoice}" MinWidth="200" VerticalAlignment="Center" ItemsSource="{x:Bind Choices}"
                          SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}" IsEditable="{x:Bind IsEditable}" TextSubmitted="OnChoiceTyped" />
            </Grid>
        </DataTemplate>

        <!-- a Category (New-AkariExpander): its icon, name and "n Tweaks", "n of m" picked on the right; the rows inside -->
        <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:TweakCategoryViewModel">
            <Expander Visibility="{x:Bind Shows, Mode=OneWay}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" Margin="0,0,0,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource TweakRowTemplate}" Margin="-16,-16,-16,-16" Padding="16,8,16,8" />
            </Expander>
        </DataTemplate>

        <!-- a Review, run or result row -->
        <DataTemplate x:Key="ReviewRowTemplate" x:DataType="vm:ReviewRow">
            <Grid ColumnSpacing="16" Padding="0,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" Visibility="{x:Bind IsRow}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Line}" Visibility="{x:Bind IsRow}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- a Review group (page D's review panel): a glass panel, its header (glyph, title, the count line) over a hairline,
             then its rows split by hairlines (none under the last: the view's SetLine) -->
        <DataTemplate x:Key="ReviewGroupTemplate" x:DataType="vm:ReviewGroup">
            <Border Style="{StaticResource GlassCard}" Padding="0" Margin="0,0,0,12">
                <StackPanel>
                    <Grid ColumnSpacing="16" Padding="18,14" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Nothing" Visibility="{x:Bind IsEmpty}" Margin="18,12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsRepeater ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ReviewRowTemplate}" Margin="18,0"
                                   ElementPrepared="OnLinedRowPrepared" ElementIndexChanged="OnLinedRowMoved" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- the Aurora banner (the design's page D), Install's light behind the steps and the footer -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <controls:AuroraBackdrop Palette="Install" Grid.RowSpan="2" />

        <ScrollViewer x:Name="Scroller">
            <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <!-- the title: in Guided an "Install AkariOS ›" link line (the chooser, picks kept), then the step -->
                <controls:PageBanner Crumbs="{x:Bind ViewModel.CrumbLinks, Mode=OneWay}" Title="{x:Bind ViewModel.Heading, Mode=OneWay}"
                                     Lead="{x:Bind ViewModel.Subheading, Mode=OneWay}" />

                <!-- the stepper: numbered circles joined by lines, done ones ticked -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Stepper, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsGuided, Mode=OneWay}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StepItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="32" Height="1" VerticalAlignment="Center" Margin="4,0" Visibility="{x:Bind HasLine}"
                                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <Grid Width="22" Height="22">
                                    <Ellipse Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" />
                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsCurrent}" />
                                    <Ellipse Fill="{ThemeResource AccentFillColorSecondaryBrush}" Visibility="{x:Bind IsDone}" />
                                    <TextBlock Text="{x:Bind NumberText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind IsCurrent}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Visibility="{x:Bind IsDone}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- the chooser: One-click (recommended) and Guided, what One-click does, the warning -->
                <StackPanel Visibility="{x:Bind ViewModel.IsChoosing, Mode=OneWay}" Spacing="8">
                    <Grid x:Name="Tiles" ColumnSpacing="8" RowSpacing="8">
                        <!-- its cards rise one after another (page D staggers a grid's cards too) -->
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <!-- the featured card (page D): the Akari bloom in its top right corner, behind its text; no padding
                             so the bloom reaches the card's edge, the text keeps the tile's 16 px -->
                        <Button Style="{StaticResource GlassTile}" Command="{x:Bind ViewModel.StartOneClickCommand}" Padding="0" VerticalContentAlignment="Stretch">
                            <Grid>
                                <controls:BloomMark Palette="Install" />
                                <StackPanel Spacing="8" Margin="16" VerticalAlignment="Top">
                                    <ContentControl Style="{StaticResource TileIcon}"><FontIcon Glyph="&#xE945;" FontSize="20" /></ContentControl>
                                    <TextBlock Text="One-click" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="The full AkariOS setup in one go: removes bloat, cleans and reinstalls graphics drivers, applies every AkariOS Tweak, including the ones that need Safe Mode. Your PC restarts several times." />
                                    <TextBlock Text="Recommended for a fresh install" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource GlassTile}" Command="{x:Bind ViewModel.GuideCommand}">
                            <StackPanel Spacing="8">
                                <ContentControl Style="{StaticResource TileIcon}"><FontIcon Glyph="&#xE8A5;" FontSize="20" /></ContentControl>
                                <TextBlock Text="Guided" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pick the apps to remove and install and the Tweaks to apply, review everything, then apply it in one go. Nothing changes until you press Apply." />
                                <TextBlock Text="For a PC you already use" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="What One-click does" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Panel}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Five phases, about 20 minutes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="AkariOS runs them in its own console and restarts the PC between them" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PhaseList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PhaseItem">
                                        <Grid ColumnSpacing="12" Padding="0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2" />
                                                <TextBlock Text="{x:Bind NumberText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind Text}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Margin="0,8,0,0" Title="Undo covers settings only"
                             Message="Settings › Recovery › Undo the last run puts settings back; removed apps and drivers stay removed. Use One-click on a fresh install or a PC you can reinstall." />
                </StackPanel>

                <!-- Guided › Apps -->
                <StackPanel Visibility="{x:Bind ViewModel.AppsShown, Mode=OneWay}" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.Apps.IsReading, Mode=OneWay}" HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.Apps.IsReading, Mode=OneWay}" />
                    <TextBlock Text="Reading the apps on this PC…" Style="{StaticResource Muted}" Visibility="{x:Bind ViewModel.Apps.IsReading, Mode=OneWay}" />
                    <!-- Get-AkariAppsView: Remove (the four lists, one at a time), then Install (tickable cards), one page -->
                    <TextBlock Text="Remove" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,4,0,0" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <DropDownButton Content="Quick select" ToolTipService.ToolTip="Pick a preset: it replaces every pick, apps and Tweaks">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom" Opening="OnQuickMenu" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBox Grid.Column="1" PlaceholderText="Filter apps" Text="{x:Bind ViewModel.Apps.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Apps.StatusText, Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </Grid>
                    <local:RemoveListsView Apps="{x:Bind ViewModel.Apps, Mode=OneWay}" />
                    <HyperlinkButton Content="Remove apps lists the same apps and features, and removes them right away" Click="OnRemoveApps" Padding="0" />
                    <TextBlock Text="Install" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,0" />
                    <!-- New-AkariCardGrid (220 px at least) of New-AkariAppCard: icon, name (a Caution install's mark), category, a
                         checkbox; a click anywhere on the card ticks it -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Apps.InstallItems, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <local:CardGridLayout MinItemWidth="220" ColumnSpacing="8" RowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppRowViewModel">
                                <Border Style="{StaticResource AppPanel}" Padding="14" Visibility="{x:Bind Shows, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind CardTip}" Tapped="OnInstallCard">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ContentControl Width="40" Height="40" Content="{x:Bind Icon}" ContentTemplate="{StaticResource AppIconTemplate}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                <FontIcon Glyph="&#xE7BA;" FontSize="12" Visibility="{x:Bind IsCautionInstall}" ToolTipService.ToolTip="{x:Bind CautionTip}"
                                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Category}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Guided › Tweaks -->
                <StackPanel Visibility="{x:Bind ViewModel.TweaksShown, Mode=OneWay}" Spacing="8">
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Title="Ticked rows are on this PC already"
                             Message="Untick one to switch it back, tick one to apply it. Quick select picks the AkariOS setup in one go." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <DropDownButton Content="Quick select" ToolTipService.ToolTip="Pick a preset: it replaces every pick on this step">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom" Opening="OnQuickMenu" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Content="Clear selection" Command="{x:Bind ViewModel.Tweaks.ResetCommand, Mode=OneWay}" ToolTipService.ToolTip="Undo every pick on this page" />
                        <CheckBox Content="Show current state" IsChecked="{x:Bind ViewModel.Tweaks.UseState, Mode=TwoWay}" MinWidth="0" Margin="8,0,0,0"
                                  ToolTipService.ToolTip="Check the Tweaks already applied on this PC. Unchecking one of them reverts it." />
                    </StackPanel>
                    <!-- the filter box (the PowerShell app has it too): the window's search box is Optimize's -->
                    <TextBox PlaceholderText="Filter tweaks" Text="{x:Bind ViewModel.Tweaks.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left" />
                    <ProgressRing IsActive="{x:Bind ViewModel.Tweaks.IsReading, Mode=OneWay}" HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.Tweaks.IsReading, Mode=OneWay}" />
                    <TextBlock Text="Reading the current state of each tweak…" Style="{StaticResource Muted}" Visibility="{x:Bind ViewModel.Tweaks.IsReading, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tweaks.Sections, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TweakSectionViewModel">
                                <StackPanel Visibility="{x:Bind Shows, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,20,0,8" />
                                    <ItemsControl ItemsSource="{x:Bind Categories}" ItemTemplate="{StaticResource CategoryTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Guided › Review & Apply -->
                <StackPanel Visibility="{x:Bind ViewModel.ReviewShown, Mode=OneWay}" Spacing="8">
                    <Grid x:Name="ReviewCounts" ColumnSpacing="8" RowSpacing="8">
                        <!-- its cards rise one after another (page D staggers a grid's cards too) -->
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.RemoveCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Apps to remove" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.InstallCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Apps to install" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TweakCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Tweaks to apply" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <InfoBar Severity="Warning" IsClosable="False" Title="Restart needed" IsOpen="{x:Bind ViewModel.HasRestartNote, Mode=OneWay}"
                             Message="{x:Bind ViewModel.RestartNote, Mode=OneWay}" />
                    <!-- Show-AkariReview as page D lays it out: a glass panel per group, Remove and Install on the left, the
                         Tweaks in the wider column on the right (one column when narrow: the view's Layout) -->
                    <Grid x:Name="ReviewColumns" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.3*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ItemsControl x:Name="ReviewSideList" ItemsSource="{x:Bind ViewModel.ReviewSide, Mode=OneWay}" ItemTemplate="{StaticResource ReviewGroupTemplate}" />
                        <ItemsControl x:Name="ReviewMainList" Grid.Column="1" ItemsSource="{x:Bind ViewModel.ReviewMain, Mode=OneWay}" ItemTemplate="{StaticResource ReviewGroupTemplate}" />
                    </Grid>
                </StackPanel>

                <!-- the run page: the overall bar, then a row per change -->
                <StackPanel Visibility="{x:Bind ViewModel.IsRun, Mode=OneWay}" Spacing="8">
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,12" />
                    <!-- the rows split by hairlines, none under the last (page D; the view sets each row's line) -->
                    <Border Style="{StaticResource Panel}" Padding="16,4">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.RunItems}" ElementPrepared="OnLinedRowPrepared" ElementIndexChanged="OnLinedRowMoved">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:RunItemViewModel">
                                    <Grid ColumnSpacing="12" Padding="0,8" MinHeight="44" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsWorking, Mode=OneWay}" Visibility="{x:Bind IsWorking, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xEC61;" FontSize="14" Visibility="{x:Bind IsOk, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <FontIcon Glyph="&#xEB90;" FontSize="14" Visibility="{x:Bind IsBad, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- the result -->
                <StackPanel Visibility="{x:Bind ViewModel.IsResult, Mode=OneWay}" Spacing="8">
                    <InfoBar Severity="Success" IsOpen="True" IsClosable="False" Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ResultText, Mode=OneWay}" />
                    <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.ResultReboot, Mode=OneWay}" Title="Restart to finish"
                             Message="Some changes take effect after a restart.">
                        <InfoBar.ActionButton>
                            <Button Content="Restart now" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RestartNowCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Grid x:Name="ResultCounts" ColumnSpacing="8" RowSpacing="8">
                        <!-- its cards rise one after another (page D staggers a grid's cards too) -->
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.OkCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Applied" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.BadCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="Failed" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SkipCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Skipped" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="Needs attention" Style="{StaticResource Section}" Visibility="{x:Bind ViewModel.HasFailed, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Failed, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultItem">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEB90;" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Why}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open log" VerticalAlignment="Center" Click="OnOpenLog" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Skipped" Style="{StaticResource Section}" Visibility="{x:Bind ViewModel.HasSkipped, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Skipped, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultItem">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE946;" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Why}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Content="Done" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.DoneCommand}" />
                        <Button Content="Open Optimize" Command="{x:Bind ViewModel.OpenOptimizeCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- the footer on the glass (Update-AkariStepFooter): "Step n of 3", Back, Next / Review (n) / Apply n changes -->
        <Border Grid.Row="1" Visibility="{x:Bind ViewModel.ShowFooter, Mode=OneWay}" Padding="36,12"
                Background="{ThemeResource AkariGlassBrush}" BorderBrush="{ThemeResource AkariGlassStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StepLabel, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                <Button Grid.Column="1" Content="Back" Command="{x:Bind ViewModel.BackCommand}" IsEnabled="{x:Bind ViewModel.CanBack, Mode=OneWay}" />
                <Button Grid.Column="2" Content="{x:Bind ViewModel.NextText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
