<Page
    x:Class="AkariOS.App.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <Page.Resources>
        <!-- a chooser tile (New-AkariTile -Big) -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- a Guided Tweaks row: a checkbox, or the name over a dropdown starting on "No change" -->
        <DataTemplate x:Key="TweakRowTemplate" x:DataType="vm:TweakRowViewModel">
            <Grid Visibility="{x:Bind Shows, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Tip}" Padding="0,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox Visibility="{x:Bind IsCheck}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{x:Bind Name}" /><Run Text="{x:Bind AkariOSTag}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </TextBlock>
                </CheckBox>
                <StackPanel Visibility="{x:Bind IsChoice}" Spacing="6">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{x:Bind Name}" /><Run Text="{x:Bind AkariOSTag}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </TextBlock>
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}"
                              IsEditable="{x:Bind IsEditable}" TextSubmitted="OnChoiceTyped" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="0,6,0,0">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind IsCaution}" ToolTipService.ToolTip="Caution"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind IsAdvanced}" ToolTipService.ToolTip="Advanced"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <FontIcon Glyph="&#xE777;" FontSize="14" Visibility="{x:Bind Reboots}" ToolTipService.ToolTip="Restart required"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <FontIcon Glyph="&#xE9CE;" FontSize="14" Visibility="{x:Bind StateUnread}" ToolTipService.ToolTip="{x:Bind StateTip}"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- a Category card: glyph, name, "n of m", its rows -->
        <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:TweakCategoryViewModel">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12" Visibility="{x:Bind Shows, Mode=OneWay}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind CountText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource TweakRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- an app row: check, mark, name, description, source -->
        <DataTemplate x:Key="AppRowTemplate" x:DataType="vm:AppRowViewModel">
            <Grid Visibility="{x:Bind Shows, Mode=OneWay}" ColumnSpacing="12" Padding="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" /><ColumnDefinition Width="20" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Visibility="{x:Bind IsSafe}" ToolTipService.ToolTip="Recommended" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <FontIcon Glyph="&#xE738;" FontSize="14" Visibility="{x:Bind IsOptional}" ToolTipService.ToolTip="Optional" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind IsRisky}" ToolTipService.ToolTip="Not recommended" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Visibility="{x:Bind IsCautionInstall}" ToolTipService.ToolTip="{x:Bind CautionTip}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{x:Bind Name}" Opacity="{x:Bind Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind NameTip}" />
                <TextBlock Grid.Column="3" Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Description}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" ToolTipService.ToolTip="{x:Bind SourceTip}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AppTableTemplate" x:DataType="vm:AppTableViewModel">
            <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" Margin="0,0,0,6" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" /><ColumnDefinition Width="20" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="Name" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Description" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Last}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock Text="{x:Bind Note, Mode=OneWay}" Visibility="{x:Bind HasNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource AppRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- a Review, run or result row -->
        <DataTemplate x:Key="ReviewRowTemplate" x:DataType="vm:ReviewRow">
            <Grid ColumnSpacing="16" Padding="0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" Visibility="{x:Bind IsRow}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Line}" Visibility="{x:Bind IsRow}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller">
            <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.Subheading, Mode=OneWay}" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,8" />

                <!-- the stepper: numbered circles joined by lines, done ones ticked -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Stepper, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsGuided, Mode=OneWay}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StepItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Rectangle Width="32" Height="1" VerticalAlignment="Center" Margin="4,0" Visibility="{x:Bind HasLine}"
                                           Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <Grid Width="22" Height="22">
                                    <Ellipse Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" StrokeThickness="1" />
                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsCurrent}" />
                                    <Ellipse Fill="{ThemeResource AccentFillColorSecondaryBrush}" Visibility="{x:Bind IsDone}" />
                                    <TextBlock Text="{x:Bind NumberText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind IsCurrent}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Visibility="{x:Bind IsDone}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- the chooser: One-click (recommended) and Guided, what One-click does, the warning -->
                <StackPanel Visibility="{x:Bind ViewModel.IsChoosing, Mode=OneWay}" Spacing="8">
                    <Grid x:Name="Tiles" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Tile}" Command="{x:Bind ViewModel.StartOneClickCommand}">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE945;" FontSize="24" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="One-click" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="The full AkariOS setup in one go: removes bloat, cleans and reinstalls graphics drivers, applies every AkariOS Tweak, including the ones that need Safe Mode. Your PC restarts several times." />
                                <TextBlock Text="Recommended for a fresh install" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource Tile}" Command="{x:Bind ViewModel.GuideCommand}">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="24" HorizontalAlignment="Left" />
                                <TextBlock Text="Guided" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pick the apps to remove and install and the Tweaks to apply, review everything, then apply it in one go. Nothing changes until you press Apply." />
                                <TextBlock Text="For a PC you already use" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="What One-click does" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Panel}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Five phases, about 20 minutes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="AkariOS runs them in its own console and restarts the PC between them" Style="{StaticResource Muted}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PhaseList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PhaseItem">
                                        <Grid ColumnSpacing="12" Padding="0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.2" />
                                                <TextBlock Text="{x:Bind NumberText}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind Text}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Margin="0,8,0,0" Title="There is no uninstaller"
                             Message="Use One-click on a fresh install or a PC you can reinstall." />
                </StackPanel>

                <!-- Guided › Apps -->
                <StackPanel Visibility="{x:Bind ViewModel.AppsShown, Mode=OneWay}" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.Apps.IsReading, Mode=OneWay}" HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.Apps.IsReading, Mode=OneWay}" />
                    <TextBlock Text="Reading the apps on this PC…" Style="{StaticResource Muted}" Visibility="{x:Bind ViewModel.Apps.IsReading, Mode=OneWay}" />
                    <SelectorBar x:Name="AppTabs" SelectionChanged="OnAppTab">
                        <SelectorBarItem Text="Remove" Tag="Remove" IsSelected="True" />
                        <SelectorBarItem Text="Install" Tag="Install" />
                    </SelectorBar>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <DropDownButton Content="Quick select" ToolTipService.ToolTip="Pick a preset: it replaces every pick, apps and Tweaks">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom" Opening="OnQuickMenu" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Apps.IsRemoveTab, Mode=OneWay}">
                            <Button Content="Select recommended" Command="{x:Bind ViewModel.Apps.SelectRecommendedCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="Win11Debloat's pick: what is on this PC and marked Recommended" />
                            <Button Content="AkariOS" Command="{x:Bind ViewModel.Apps.SelectAkariOSCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="The AkariOS debloat (FR33THY's): everything on this PC except its keep-list" />
                            <Button Content="Clear selection" Command="{x:Bind ViewModel.Apps.ClearRemovalsCommand, Mode=OneWay}" />
                            <CheckBox Content="Only installed" IsChecked="{x:Bind ViewModel.Apps.OnlyInstalled, Mode=TwoWay}" MinWidth="0" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button Content="Clear selection" Command="{x:Bind ViewModel.Apps.ClearInstallsCommand, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Apps.IsInstallTab, Mode=OneWay}" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="Filter apps" Text="{x:Bind ViewModel.Apps.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Apps.StatusText, Mode=OneWay}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Apps.RemoveTables, Mode=OneWay}" ItemTemplate="{StaticResource AppTableTemplate}"
                                  Visibility="{x:Bind ViewModel.Apps.IsRemoveTab, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Apps.InstallTables, Mode=OneWay}" ItemTemplate="{StaticResource AppTableTemplate}"
                                  Visibility="{x:Bind ViewModel.Apps.IsInstallTab, Mode=OneWay}" />
                </StackPanel>

                <!-- Guided › Tweaks -->
                <StackPanel Visibility="{x:Bind ViewModel.TweaksShown, Mode=OneWay}" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <DropDownButton Content="Quick select" ToolTipService.ToolTip="Pick a preset: it replaces every pick on this step">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom" Opening="OnQuickMenu" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Content="Clear selection" Command="{x:Bind ViewModel.Tweaks.ResetCommand, Mode=OneWay}" ToolTipService.ToolTip="Undo every pick on this page" />
                        <CheckBox Content="Show current state" IsChecked="{x:Bind ViewModel.Tweaks.UseState, Mode=TwoWay}" MinWidth="0" Margin="8,0,0,0"
                                  ToolTipService.ToolTip="Check the Tweaks already applied on this PC. Unchecking one of them reverts it." />
                    </StackPanel>
                    <TextBox PlaceholderText="Filter tweaks" Text="{x:Bind ViewModel.Tweaks.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" />
                    <ProgressRing IsActive="{x:Bind ViewModel.Tweaks.IsReading, Mode=OneWay}" HorizontalAlignment="Left"
                                  Visibility="{x:Bind ViewModel.Tweaks.IsReading, Mode=OneWay}" />
                    <TextBlock Text="Reading the current state of each tweak…" Style="{StaticResource Muted}" Visibility="{x:Bind ViewModel.Tweaks.IsReading, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tweaks.Sections, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TweakSectionViewModel">
                                <StackPanel Visibility="{x:Bind Shows, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Header}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="2,12,0,10" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{x:Bind ThirdWidth, Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl ItemsSource="{x:Bind Column0, Mode=OneWay}" ItemTemplate="{StaticResource CategoryTemplate}" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Column1, Mode=OneWay}" ItemTemplate="{StaticResource CategoryTemplate}" />
                                        <ItemsControl Grid.Column="2" ItemsSource="{x:Bind Column2, Mode=OneWay}" ItemTemplate="{StaticResource CategoryTemplate}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Guided › Review & Apply -->
                <StackPanel Visibility="{x:Bind ViewModel.ReviewShown, Mode=OneWay}" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.RemoveCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Apps to remove" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.InstallCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Apps to install" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TweakCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Tweaks to apply" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <InfoBar Severity="Warning" IsClosable="False" Title="Restart needed" IsOpen="{x:Bind ViewModel.HasRestartNote, Mode=OneWay}"
                             Message="{x:Bind ViewModel.RestartNote, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Review, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewGroup">
                                <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Nothing" Visibility="{x:Bind IsEmpty}" Margin="36,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource ReviewRowTemplate}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- the run page: the overall bar, then a row per change -->
                <StackPanel Visibility="{x:Bind ViewModel.IsRun, Mode=OneWay}" Spacing="8">
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}" Style="{StaticResource Muted}" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource Muted}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" Margin="0,0,0,12" />
                    <Border Style="{StaticResource Panel}" Padding="16,4">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RunItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RunItemViewModel">
                                    <Grid ColumnSpacing="12" Padding="0,8" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsWorking, Mode=OneWay}" Visibility="{x:Bind IsWorking, Mode=OneWay}" />
                                            <FontIcon Glyph="&#xEC61;" FontSize="14" Visibility="{x:Bind IsOk, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <FontIcon Glyph="&#xEB90;" FontSize="14" Visibility="{x:Bind IsBad, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- the result -->
                <StackPanel Visibility="{x:Bind ViewModel.IsResult, Mode=OneWay}" Spacing="8">
                    <InfoBar Severity="Success" IsOpen="True" IsClosable="False" Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ResultText, Mode=OneWay}" />
                    <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.ResultReboot, Mode=OneWay}" Title="Restart to finish"
                             Message="Some changes take effect after a restart.">
                        <InfoBar.ActionButton>
                            <Button Content="Restart now" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RestartNowCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.OkCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Applied" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.BadCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="Failed" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SkipCount, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Skipped" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="Needs attention" Style="{StaticResource Section}" Visibility="{x:Bind ViewModel.HasFailed, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Failed, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultItem">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEB90;" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Why}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open log" VerticalAlignment="Center" Click="OnOpenLog" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Skipped" Style="{StaticResource Section}" Visibility="{x:Bind ViewModel.HasSkipped, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Skipped, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ResultItem">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE946;" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Why}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Content="Done" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.DoneCommand}" />
                        <Button Content="Open Optimize" Command="{x:Bind ViewModel.OpenOptimizeCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- the footer (Update-AkariStepFooter): "Step n of 3", Back, Next / Review (n) / Apply n changes -->
        <Border Grid.Row="1" Visibility="{x:Bind ViewModel.ShowFooter, Mode=OneWay}" Padding="36,12"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.StepLabel, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                <Button Grid.Column="1" Content="Back" Command="{x:Bind ViewModel.BackCommand}" IsEnabled="{x:Bind ViewModel.CanBack, Mode=OneWay}" />
                <Button Grid.Column="2" Content="{x:Bind ViewModel.NextText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.NextCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
