<UserControl
    x:Class="AkariOS.App.Views.TasksListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <!-- DataContext: a TasksListViewModel (the Scheduled tasks page's list, under its Tweaks) -->
    <StackPanel Spacing="8" Margin="0,16,0,0">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding FilterChoices}" SelectedValuePath="Value" SelectedValue="{Binding Filter, Mode=TwoWay}" MinWidth="150" />
            <AutoSuggestBox Grid.Column="1" PlaceholderText="Search tasks" QueryIcon="Find" Text="{Binding Query, Mode=TwoWay}" />
            <ToggleSwitch Grid.Column="2" OnContent="Show all" OffContent="Show all" IsOn="{Binding ShowAll, Mode=TwoWay}" MinWidth="0"
                          ToolTipService.ToolTip="Off: only the tasks FR33THY and ZOICWARE turn off. On: every task on this PC, apps' updaters included." />
            <Button Grid.Column="3" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Read the tasks again">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Text="{Binding CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ItemsRepeater ItemsSource="{Binding Shown}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskRowViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="16,10" Margin="0,0,0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind Path}" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind Author}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                           ToolTipService.ToolTip="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind SuggestText}" Visibility="{x:Bind HasSuggest}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind ShowPlainLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind IsError, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" OnContent="On" OffContent="Off" MinWidth="0"
                                          IsOn="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
