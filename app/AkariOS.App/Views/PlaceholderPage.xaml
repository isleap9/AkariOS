<Page
    x:Class="AkariOS.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AkariOS.App.Controls">

    <!-- the Aurora banner (the design's page D), Home's light: a page still to come -->
    <Grid>
        <controls:AuroraBackdrop Palette="Home" />
        <ScrollViewer x:Name="Scroller">
            <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="16" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <controls:PageBanner Title="{x:Bind ViewModel.Title, Mode=OneWay}" />
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Not here yet" Message="{x:Bind ViewModel.Text, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
