<Page
    x:Class="AkariOS.App.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MaxWidth="1064" Padding="36,28" Spacing="16">
        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Not here yet" Message="{x:Bind ViewModel.Text, Mode=OneWay}" />
    </StackPanel>
</Page>
