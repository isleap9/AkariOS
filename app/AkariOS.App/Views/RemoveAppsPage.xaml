<Page
    x:Class="AkariOS.App.Views.RemoveAppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AkariOS.App.Views">

    <ScrollViewer x:Name="Scroller">
        <StackPanel x:Name="Column" Padding="36,28" Spacing="8">
            <TextBlock Text="Remove apps" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                       Text="Store apps, optional features, Windows features and legacy apps. Safe ones are picked by &quot;Select recommended&quot;; Caution and Advanced ones say why." />
            <!-- the command bar: the filter, "n selected", the accent Remove (n) -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Filter apps" Text="{x:Bind ViewModel.Apps.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="360" HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RemoveCommand}" IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.RemoveText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
            <local:RemoveListsView Apps="{x:Bind ViewModel.Apps, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
