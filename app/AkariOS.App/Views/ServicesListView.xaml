<UserControl
    x:Class="AkariOS.App.Views.ServicesListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AkariOS.App.ViewModels">

    <!-- DataContext: a ServicesListViewModel (the Services page's list, under its Tweaks) -->
    <StackPanel Spacing="8" Margin="0,16,0,0">
        <!-- the toolbar: filter, search, Show all, Refresh, the count -->
        <!-- the toolbar on the glass (the design's page D); the rows stay on the plain card fill (long lists) -->
        <Border Style="{StaticResource GlassCard}" Padding="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding FilterChoices}" SelectedValuePath="Value" SelectedValue="{Binding Filter, Mode=TwoWay}" MinWidth="150"
                          ToolTipService.ToolTip="Not default: startup types that differ from the Windows default (for the services AkariOS knows the default of)" />
                <AutoSuggestBox Grid.Column="1" PlaceholderText="Search services" QueryIcon="Find" Text="{Binding Query, Mode=TwoWay}" />
                <ToggleSwitch Grid.Column="2" Header="" OnContent="Show all" OffContent="Show all" IsOn="{Binding ShowAll, Mode=TwoWay}" MinWidth="0"
                              ToolTipService.ToolTip="Off: only the services FR33THY and ZOICWARE change, the ones known to be safe to turn off. On: every service on this PC, to go further." />
                <Button Grid.Column="3" Command="{Binding RefreshCommand}" ToolTipService.ToolTip="Read the services again">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        <TextBlock Text="{Binding CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

        <ItemsRepeater ItemsSource="{Binding Shown}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ServiceRowViewModel">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="16,10" Margin="0,0,0,4">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind Name}" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Visibility="{x:Bind IsRunning, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Visibility="{x:Bind IsStopped, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind DefaultText, Mode=OneWay}" Visibility="{x:Bind IsDefault, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{x:Bind DefaultText, Mode=OneWay}" Visibility="{x:Bind IsChanged, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Description}" Visibility="{x:Bind HasDescription}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                           ToolTipService.ToolTip="{x:Bind Description}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind SuggestText, Mode=OneWay}" Visibility="{x:Bind HasSuggest, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind ShowPlainLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind StateLine, Mode=OneWay}" Visibility="{x:Bind IsError, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{x:Bind ActionText, Mode=OneWay}" MinWidth="76" VerticalAlignment="Center"
                                    Visibility="{x:Bind HasAction, Mode=OneWay}" IsEnabled="{x:Bind IsIdle, Mode=OneWay}" Command="{x:Bind ActCommand}" />
                            <ComboBox Grid.Column="2" Width="230" VerticalAlignment="Center" ToolTipService.ToolTip="Startup type"
                                      ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind SelectedStart, Mode=TwoWay}" IsEnabled="{x:Bind CanChangeStart, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </StackPanel>
</UserControl>
