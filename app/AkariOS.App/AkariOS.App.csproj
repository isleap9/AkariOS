<!-- The WinUI 3 app and the CLI: AkariOS-Native.exe (ADR 0009; the PowerShell app's launcher is AkariOS.exe).
     Unpackaged, the Windows App SDK self-contained: nothing to install first. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWinUI>true</UseWinUI>
    <AssemblyName>AkariOS-Native</AssemblyName>
    <!-- CsWinRT1032 (SDK 10.0.404+): a collection expression typed as a read-only interface has no concrete type for
         trimming / AOT. The app is neither trimmed nor AOT-compiled (a plain single-file publish), so it doesn't apply. -->
    <NoWarn>$(NoWarn);CsWinRT1032</NoWarn>
    <RootNamespace>AkariOS.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(AkariSrc)Assets\AkariLogo.ico</ApplicationIcon>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- still unpackaged: single-file publishing needs it to embed resources.pri -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Program.Main: the CLI and the Run consoles before any XAML -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AkariOS.Core\AkariOS.Core.csproj" />
    <ProjectReference Include="..\AkariOS.Tweaks\AkariOS.Tweaks.csproj" />
    <ProjectReference Include="..\AkariOS.Framework\AkariOS.Framework.csproj" />
  </ItemGroup>
  <!-- the logos and app icons from src/Assets, built into the exe (a single-file publish has no folder next to it):
       Shell/AssetFiles.cs unpacks them on first use -->
  <ItemGroup>
    <EmbeddedResource Include="$(AkariSrc)Assets\AkariLogo.ico;$(AkariSrc)Assets\AkariLogo.png;$(AkariSrc)Assets\AkariLogo-dark.png;$(AkariSrc)Assets\AkariLogo-light.png" LogicalName="Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(AkariSrc)Assets\Apps\*.png" LogicalName="Assets/Apps/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.251221100" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>
</Project>
